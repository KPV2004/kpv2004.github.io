---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<Layout>
  <Navbar />

  <article class="detail-container">
    <div class="back-nav">
      <a href="/projects" class="back-link">&larr; Back to All Projects</a>
    </div>

    <header class="detail-header">
      <span class="category-badge">{data.category}</span>
      <h1 class="detail-title">{data.title}</h1>
      <p class="detail-desc">{data.description}</p>

      <div class="tags-container">
        {data.tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>

      <div class="header-actions">
        {data.github && (
          <a href={data.github} target="_blank" rel="noopener noreferrer" class="btn btn-github">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub Repository
          </a>
        )}
        {data.demo && (
          <a href={data.demo} target="_blank" rel="noopener noreferrer" class="btn btn-demo">
            Live Preview &rarr;
          </a>
        )}
      </div>
    </header>

    <main class="mdx-content">
      <Content />
    </main>
  </article>

  <Footer />
</Layout>

<style>
  .detail-container {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.25rem 4rem;
  }

  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: #ff7e5f;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #ff9d85;
    text-decoration: underline;
  }

  .detail-header {
    background: rgba(30, 20, 24, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 2.5rem;
    backdrop-filter: blur(12px);
  }

  .category-badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: #feb47b;
    background: rgba(254, 180, 123, 0.12);
    padding: 0.25rem 0.8rem;
    border-radius: 9999px;
  }

  .detail-title {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 1rem 0 0.75rem 0;
  }

  .detail-desc {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: #c7b2ad;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .tag-pill {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.05);
    color: #f5e8e4;
    padding: 0.25rem 0.65rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.65rem 1.25rem;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-github {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .btn-demo {
    background: linear-gradient(135deg, #e05a36 0%, #ff7a59 100%);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(224, 90, 54, 0.35);
  }

  .btn-demo:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(224, 90, 54, 0.5);
  }

  /* MDX Content Styling */
  .mdx-content {
    background: rgba(30, 20, 24, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    color: #c7b2ad;
    line-height: 1.75;
    font-size: 1rem;
    overflow-x: hidden;
  }

  .mdx-content :global(h1),
  .mdx-content :global(h2),
  .mdx-content :global(h3) {
    color: #ffffff;
    margin-top: 1.75rem;
    margin-bottom: 0.85rem;
    font-weight: 700;
  }

  .mdx-content :global(h1) { font-size: clamp(1.4rem, 4vw, 1.8rem); }
  .mdx-content :global(h2) { font-size: clamp(1.2rem, 3.5vw, 1.4rem); border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.4rem; }
  .mdx-content :global(h3) { font-size: clamp(1.05rem, 3vw, 1.2rem); }

  .mdx-content :global(p) {
    margin-bottom: 1.15rem;
  }

  .mdx-content :global(ul), .mdx-content :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .mdx-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .mdx-content :global(code) {
    background: rgba(255, 255, 255, 0.08);
    color: #ff9d85;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    font-size: 0.88em;
  }

  .mdx-content :global(pre) {
    background: #120c0f !important;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1rem;
    overflow-x: auto;
    max-width: 100%;
    margin: 1.25rem 0;
  }

  @media (max-width: 640px) {
    .header-actions { flex-direction: column; width: 100%; }
    .btn { width: 100%; }
  }
</style>
