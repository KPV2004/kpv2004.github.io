---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection('projects');
const projects = allProjects.filter(p => p.data.featured).slice(0, 3);

const skills = [
  { name: "Frontend", items: ["React", "TypeScript", "Tailwind CSS", "Next.js", "Laravel", "Vue", "Framer Motion"] },
  { name: "Backend", items: ["Node.js", "Python", "PostgreSQL", "MySQL", "MongoDB", "Docker", "Firebase"] },
  { name: "Tools & DevOps", items: ["Git", "Docker", "Figma", "CI/CD", "Firebase", "Postman"] }
];
---

<Layout>
  <Navbar />

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-bg-glow"></div>
    <div class="hero-container">
      <div class="status-badge">
        <span class="status-dot"></span>
        <span>{t('hero.status')}</span>
      </div>

      <h1 class="hero-title">
        {t('hero.title_pre')}<span class="highlight-name">{t('hero.title_highlight')}</span>
      </h1>

      <p class="hero-subtitle">
        {t('hero.subtitle')}
      </p>

      <div class="hero-cta-group">
        <a href={lang === 'th' ? '/th/projects' : '/projects'} class="btn btn-primary">
          {t('hero.explore')}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a href={lang === 'th' ? '/th/contact' : '/contact'} class="btn btn-secondary">{t('hero.contact')}</a>
      </div>

      <!-- Quick Metrics -->
      <div class="hero-stats">
        <div class="stat-card">
          <span class="stat-number">1+</span>
          <span class="stat-label">{t('hero.exp')}</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-card">
          <span class="stat-number">10+</span>
          <span class="stat-label">{t('hero.projects_count')}</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-card">
          <span class="stat-number">6+</span>
          <span class="stat-label">{t('hero.awards_count')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="section">
    <div class="section-container">
      <div class="section-header">
        <div>
          <span class="section-tag">{t('section.featured')}</span>
          <h2 class="section-title">{t('section.projects_title')}</h2>
        </div>
        <a href={lang === 'th' ? '/th/projects' : '/projects'} class="view-all-link">
          {t('section.view_all_projects')}
        </a>
      </div>

      <div class="projects-grid">
        {projects.map((project) => {
          const projectSlug = project.id.replace(/\.mdx?$/, '');
          const { data } = project;
          const detailLink = lang === 'th' ? `/th/projects/${projectSlug}` : `/projects/${projectSlug}`;
          return (
            <div class="project-card">
              {data.image && (
                <a href={detailLink} class="card-image-wrapper">
                  <img src={data.image} alt={data.title} loading="lazy" class="card-image" />
                  <div class="image-overlay"></div>
                </a>
              )}
              <div class="card-content">
                <div class="card-header">
                  <span class="category-badge">{data.category}</span>
                </div>
                <h3 class="card-title">{data.title}</h3>
                <p class="card-description">{data.description}</p>
                <div class="card-tags">
                  {data.tags.map(tag => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
                <a href={detailLink} class="card-link">
                  {t('card.read_mdx')}
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Skills & Technologies -->
  <section class="section skills-section">
    <div class="section-container">
      <div class="section-header center">
        <span class="section-tag">{t('section.tech_stack')}</span>
        <h2 class="section-title">{t('section.skills_title')}</h2>
      </div>

      <div class="skills-grid">
        {skills.map((category) => (
          <div class="skill-card">
            <h3 class="skill-category-title">{category.name}</h3>
            <div class="skill-items">
              {category.items.map((item) => (
                <div class="skill-pill">
                  <span class="pill-dot"></span>
                  {item}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="cta-box">
      <h2>{t('section.cta_title')}</h2>
      <p>{t('section.cta_desc')}</p>
      <a href={lang === 'th' ? '/th/contact' : '/contact'} class="btn btn-primary btn-large">{t('section.cta_button')}</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    position: relative;
    padding: clamp(3rem, 8vw, 6rem) 1.25rem 3rem;
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 90vw);
    height: 350px;
    background: radial-gradient(circle, rgba(255, 107, 74, 0.22) 0%, rgba(220, 38, 38, 0.05) 50%, rgba(0, 0, 0, 0) 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(255, 107, 74, 0.1);
    border: 1px solid rgba(255, 107, 74, 0.25);
    color: #ff9d85;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #ff6b4a;
    border-radius: 50%;
    box-shadow: 0 0 10px #ff6b4a;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .hero-title {
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 1.25rem 0;
  }

  .highlight-name {
    background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    line-height: 1.6;
    color: #c7b2ad;
    max-width: 680px;
    margin: 0 auto 2rem;
  }

  .hero-cta-group {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-primary {
    background: linear-gradient(135deg, #e05a36 0%, #ff7a59 100%);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(224, 90, 54, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(224, 90, 54, 0.55);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #f5e8e4;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  .btn-large {
    padding: 0.9rem 2rem;
    font-size: 1.05rem;
  }

  /* Stats */
  .hero-stats {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(30, 20, 24, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    padding: 1.1rem 2rem;
    border-radius: 20px;
    gap: 2rem;
    max-width: 100%;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 1.7rem;
    font-weight: 800;
    color: #ff7e5f;
  }

  .stat-label {
    font-size: 0.82rem;
    color: #a08d88;
    white-space: nowrap;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Section Styling */
  .section {
    padding: clamp(2.5rem, 6vw, 4rem) 1.25rem;
  }

  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-header.center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-tag {
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ff6b4a;
    display: block;
    margin-bottom: 0.3rem;
  }

  .section-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .view-all-link {
    color: #ff7e5f;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: #ff9d85;
    text-decoration: underline;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: rgba(30, 20, 24, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 107, 74, 0.4);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
    display: block;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card:hover .card-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30, 20, 24, 0.9) 0%, transparent 60%);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: #feb47b;
    background: rgba(254, 180, 123, 0.12);
    padding: 0.22rem 0.7rem;
    border-radius: 9999px;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0.9rem 0 0.5rem 0;
  }

  .card-description {
    font-size: 0.92rem;
    color: #a08d88;
    line-height: 1.6;
    margin: 0 0 1.15rem 0;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.15rem;
  }

  .tag-chip {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    color: #c7b2ad;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ff7e5f;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: gap 0.2s ease;
  }

  .card-link:hover {
    gap: 10px;
  }

  /* Skills Section */
  .skills-section {
    background: rgba(22, 14, 17, 0.5);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    background: rgba(30, 20, 24, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 1.5rem;
  }

  .skill-category-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1.1rem 0;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #f5e8e4;
    padding: 0.4rem 0.8rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff6b4a;
  }

  /* CTA Section */
  .cta-section {
    padding-top: 1.5rem;
  }

  .cta-box {
    max-width: 900px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(50, 25, 32, 0.9) 0%, rgba(30, 20, 24, 0.9) 100%);
    border: 1px solid rgba(255, 107, 74, 0.3);
    border-radius: 24px;
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    text-align: center;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .cta-box h2 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.85rem 0;
  }

  .cta-box p {
    font-size: 1rem;
    color: #c7b2ad;
    max-width: 550px;
    margin: 0 auto 1.75rem;
  }

  /* Responsive Breakpoints */
  @media (max-width: 640px) {
    .hero-cta-group { flex-direction: column; width: 100%; }
    .btn { width: 100%; }
    .hero-stats { flex-direction: column; gap: 1rem; width: 100%; border-radius: 16px; }
    .stat-divider { display: none; }
  }
</style>
