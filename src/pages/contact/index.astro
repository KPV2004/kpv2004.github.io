---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <Navbar />

  <section class="page-header" id="main-content">
    <div class="header-container">
      <span class="section-tag">{t('contact.tag')}</span>
      <h1 class="page-title">{t('contact.title')}</h1>
      <p class="page-description">
        {t('contact.desc')}
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-container">
      <div class="contact-grid">
        <!-- Contact Info Card -->
        <div class="info-card">
          <h2 class="card-heading">{t('contact.info')}</h2>
          <p class="info-intro">
            {lang === 'th' ? 'สามารถติดต่อปานเนตรผ่านอีเมลหรือช่องทางออนไลน์เพื่อพูดคุย สอบถาม หรือร่วมงานกันได้เสมอครับ' : 'Feel free to reach out directly via email or connect with me on social platforms.'}
          </p>

          <div class="contact-methods">
            <a href="mailto:pannetvanicharkorl@gmail.com" class="method-item">
              <div class="icon-box">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div class="method-details">
                <span class="method-label">Email</span>
                <span class="method-value">pannetvanicharkorl@gmail.com</span>
              </div>
            </a>

            <a href="https://github.com/KPV2004" target="_blank" rel="noopener noreferrer" class="method-item">
              <div class="icon-box">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              </div>
              <div class="method-details">
                <span class="method-label">GitHub</span>
                <span class="method-value">github.com/KPV2004</span>
              </div>
            </a>

            <a href="https://www.linkedin.com/in/pannet-vanicharkorl/" target="_blank" rel="noopener noreferrer" class="method-item">
              <div class="icon-box">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/>
                </svg>
              </div>
              <div class="method-details">
                <span class="method-label">LinkedIn</span>
                <span class="method-value">linkedin.com/in/pannet-vanicharkorl</span>
              </div>
            </a>
          </div>
        </div>

        <!-- The form opens a prepared email draft; no fake submission state. -->
        <div class="form-card">
          <form class="contact-form" id="contact-form">
            <div class="form-group">
              <label for="name">{t('contact.name_label')}</label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder={lang === 'th' ? 'ระบุชื่อของคุณ' : 'John Doe'} />
            </div>

            <div class="form-group">
              <label for="email">{t('contact.email_label')}</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder={lang === 'th' ? 'name@example.com' : 'john@example.com'} />
            </div>

            <div class="form-group">
              <label for="subject">{t('contact.subject_label')}</label>
              <input type="text" id="subject" name="subject" required placeholder={lang === 'th' ? 'หัวข้อที่ต้องการติดต่อ' : 'Project Inquiry / Job Opportunity'} />
            </div>

            <div class="form-group">
              <label for="message">{t('contact.message_label')}</label>
              <textarea id="message" name="message" rows="5" required placeholder={lang === 'th' ? 'พิมพ์รายละเอียดข้อความของคุณที่นี่...' : 'Tell me about your project or inquiry...'}></textarea>
            </div>

            <button type="submit" class="submit-btn">{t('contact.send')}</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(contactForm);
    const subject = String(data.get("subject") || "Portfolio inquiry");
    const name = String(data.get("name") || "");
    const email = String(data.get("email") || "");
    const message = String(data.get("message") || "");
    const body = `${message}\n\n— ${name}\n${email}`;
    window.location.href = `mailto:pannetvanicharkorl@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .page-header {
    padding: 5rem 1.75rem 3rem;
    text-align: center;
    background: radial-gradient(circle at top, rgba(126, 231, 135, 0.15) 0%, rgba(0,0,0,0) 70%);
  }

  .header-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-tag {
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #7ee787;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.8rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .page-description {
    font-size: 1.15rem;
    color: #b7c2cd;
    line-height: 1.6;
    margin: 0;
  }

  .contact-section {
    padding: 3rem 1.75rem 5rem;
  }

  .contact-container {
    max-width: 1050px;
    margin: 0 auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
  }

  /* Info Card */
  .info-card {
    background: rgba(17, 23, 31, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 2.25rem;
    backdrop-filter: blur(12px);
  }

  .card-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .info-intro {
    font-size: 1rem;
    color: #b7c2cd;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .method-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .method-item:hover {
    background: rgba(126, 231, 135, 0.12);
    border-color: rgba(126, 231, 135, 0.3);
    transform: translateX(4px);
  }

  .icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(126, 231, 135, 0.15);
    color: #79c0ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-details {
    display: flex;
    flex-direction: column;
  }

  .method-label {
    font-size: 0.8rem;
    color: #8e9ba9;
    font-weight: 500;
  }

  .method-value {
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Form Card */
  .form-card {
    background: rgba(17, 23, 31, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 2.25rem;
    backdrop-filter: blur(12px);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: #edf4f8;
  }

  .form-group input, .form-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: rgba(8, 11, 15, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-family: inherit;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: #7ee787;
    box-shadow: 0 0 0 3px rgba(126, 231, 135, 0.2);
  }

  .submit-btn {
    background: linear-gradient(135deg, #57ab5a 0%, #7ee787 100%);
    color: #ffffff;
    border: none;
    padding: 0.9rem 1.75rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(126, 231, 135, 0.35);
    margin-top: 0.5rem;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(126, 231, 135, 0.5);
  }

  @media (max-width: 850px) {
    .contact-grid { grid-template-columns: 1fr; }
    .page-title { font-size: 2.2rem; }
  }
</style>
