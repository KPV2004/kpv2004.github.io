---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const certificates = await getCollection('certificates');
---

<Layout>
  <Navbar />

  <section class="page-header">
    <div class="header-container">
      <span class="section-tag">Credentials</span>
      <h1 class="page-title">Certificates & Training</h1>
      <p class="page-description">
        Professional certificates and security training programs completed by Pannet Vanicharkorl. Click any certificate to view full MDX documentation.
      </p>
    </div>
  </section>

  <section class="certs-section">
    <div class="certs-container">
      <div class="certs-grid">
        {certificates.map((cert) => {
          const certSlug = cert.id.replace(/\.mdx?$/, '');
          const { data } = cert;
          return (
            <div class="cert-card">
              {data.image && (
                <a href={`/certifications/${certSlug}`} class="cert-image-wrapper">
                  <img src={data.image} alt={data.title} loading="lazy" class="cert-image" />
                </a>
              )}
              <div class="cert-body">
                <div class="cert-header">
                  <span class="cert-date">{data.date}</span>
                </div>
                <h2 class="cert-title">{data.title}</h2>
                <span class="cert-issuer">Issued by {data.issuer}</span>

                <div class="skills-list">
                  {data.skills.map((skill) => (
                    <span class="skill-tag">{skill}</span>
                  ))}
                </div>

                <a href={`/certifications/${certSlug}`} class="details-link">
                  View MDX Details &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 5rem 1.75rem 3rem;
    text-align: center;
    background: radial-gradient(circle at top, rgba(255, 107, 74, 0.15) 0%, rgba(0,0,0,0) 70%);
  }

  .header-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-tag {
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ff6b4a;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .page-description {
    font-size: 1.15rem;
    color: #c7b2ad;
    line-height: 1.6;
    margin: 0;
  }

  .certs-section {
    padding: 3rem 1.75rem 5rem;
  }

  .certs-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .cert-card {
    background: rgba(30, 20, 24, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .cert-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 107, 74, 0.4);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
  }

  .cert-image-wrapper {
    width: 100%;
    height: 180px;
    overflow: hidden;
    display: block;
  }

  .cert-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cert-card:hover .cert-image {
    transform: scale(1.05);
  }

  .cert-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .cert-header {
    margin-bottom: 0.3rem;
  }

  .cert-date {
    font-size: 0.8rem;
    color: #a08d88;
  }

  .cert-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.3rem 0;
  }

  .cert-issuer {
    font-size: 0.88rem;
    color: #feb47b;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .skill-tag {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    color: #c7b2ad;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .details-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ff7e5f;
    text-decoration: none;
    transition: color 0.2s ease;
    margin-top: auto;
  }

  .details-link:hover {
    color: #ff9d85;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>
