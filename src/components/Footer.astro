    <div class="footer-bottom">
      <p>&copy; {currentYear} Pannet Vanicharkorl. All rights reserved.</p>
      <p class="crafted-with">Designed & Built with Astro & MDX</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: rgba(18, 12, 15, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4rem 1.75rem 2rem;
    margin-top: 5rem;
    color: #c7b2ad;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .brand-first {
    background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-dot {
    color: #ff6b4a;
  }

  .brand-last {
    color: #f5e8e4;
  }

  .brand-tagline {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #a08d88;
    max-width: 380px;
    margin: 0;
  }

  .nav-title {
    color: #f5e8e4;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    color: #a08d88;
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #ff6b4a;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f5e8e4;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .social-btn:hover {
    background: #ff6b4a;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(255, 107, 74, 0.4);
    border-color: #ff6b4a;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.85rem;
    color: #887470;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
