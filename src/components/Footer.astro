---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-logo">
          <span class="brand-first">Pannet</span>
          <span class="brand-dot">.</span>
          <span class="brand-last">Vanicharkorl</span>
        </a>
        <p class="brand-tagline">
          Full Stack Developer & Computer Engineering student at Kasetsart University Sriracha Campus. Building digital experiences that matter.
        </p>
      </div>

      <div class="footer-nav-group">
        <h4 class="nav-title">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Me</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/competitions">Competitions</a></li>
          <li><a href="/certifications">Certifications</a></li>
          <li><a href="/contact">Contact</a></li>
