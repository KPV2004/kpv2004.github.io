---
import {
    getLangFromUrl,
    useTranslations,
    getLocalizedPath,
} from "../utils/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");

// Create base route without locale prefix
const baseRoute =
    lang === "th" ? currentPath.replace(/^\/th/, "") || "/" : currentPath;

const navItems = [
    { name: t("nav.home"), href: lang === "th" ? "/th" : "/" },
    { name: t("nav.about"), href: lang === "th" ? "/th/about" : "/about" },
    {
        name: t("nav.projects"),
        href: lang === "th" ? "/th/projects" : "/projects",
    },
    {
        name: t("nav.competitions"),
        href: lang === "th" ? "/th/competitions" : "/competitions",
    },
    {
        name: t("nav.certifications"),
        href: lang === "th" ? "/th/certifications" : "/certifications",
    },
    {
        name: t("nav.contact"),
        href: lang === "th" ? "/th/contact" : "/contact",
        isCta: true,
    },
];

const targetLang = lang === "en" ? "th" : "en";
const switchPath = getLocalizedPath(pathname, targetLang);
---

<header class="navbar-header">
    <div class="navbar-container">
        <a href={lang === "th" ? "/th" : "/"} class="nav-brand">
            <span class="brand-first">Pannet</span>
            <span class="brand-dot">.</span>
            <span class="brand-last">Vanicharkorl</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav">
            <ul class="nav-links">
                {
                    navItems.map((item) => {
                        const itemBaseHref =
                            lang === "th"
                                ? item.href.replace(/^\/th/, "") || "/"
                                : item.href;
                        const isActive =
                            baseRoute === itemBaseHref ||
                            (itemBaseHref !== "/" &&
                                baseRoute.startsWith(itemBaseHref));
                        return (
                            <li class="nav-item">
                                <a
                                    href={item.href}
                                    class:list={[
                                        "nav-link",
                                        { active: isActive },
                                        { "cta-button": item.isCta },
                                    ]}
                                >
                                    {item.name}
                                </a>
                            </li>
                        );
                    })
                }
            </ul>

            <!-- Language Switcher -->
            <a
                href={switchPath}
                class="lang-switch"
                title={`Switch to ${targetLang.toUpperCase()}`}
            >
                <span
                    class:list={["lang-chip", { "active-lang": lang === "en" }]}
                    >EN</span
                >
                <span class="lang-divider">|</span>
                <span
                    class:list={["lang-chip", { "active-lang": lang === "th" }]}
                    >TH</span
                >
            </a>
        </nav>

        <!-- Mobile Hamburger Toggle -->
        <div class="mobile-controls">
            <a
                href={switchPath}
                class="lang-switch mobile-lang"
                title={`Switch to ${targetLang.toUpperCase()}`}
            >
                <span
                    class:list={["lang-chip", { "active-lang": lang === "en" }]}
                    >EN</span
                >
                <span class="lang-divider">|</span>
                <span
                    class:list={["lang-chip", { "active-lang": lang === "th" }]}
                    >TH</span
                >
            </a>

            <button
                class="mobile-toggle"
                id="mobile-toggle-btn"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
            >
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-nav" id="mobile-menu">
        <ul class="mobile-links">
            {
                navItems.map((item) => {
                    const itemBaseHref =
                        lang === "th"
                            ? item.href.replace(/^\/th/, "") || "/"
                            : item.href;
                    const isActive =
                        baseRoute === itemBaseHref ||
                        (itemBaseHref !== "/" &&
                            baseRoute.startsWith(itemBaseHref));
                    return (
                        <li class="mobile-item">
                            <a
                                href={item.href}
                                class:list={[
                                    "mobile-link",
                                    { active: isActive },
                                    { "mobile-cta": item.isCta },
                                ]}
                            >
                                {item.name}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</header>

<script>
    const toggleBtn = document.getElementById("mobile-toggle-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener("click", () => {
            const isExpanded =
                toggleBtn.getAttribute("aria-expanded") === "true";
            toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
            toggleBtn.classList.toggle("is-active");
            mobileMenu.classList.toggle("is-open");
        });

        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                toggleBtn.setAttribute("aria-expanded", "false");
                toggleBtn.classList.remove("is-active");
                mobileMenu.classList.remove("is-open");
            });
        });
    }
</script>

<style>
    :root {
        --nav-bg: rgba(20, 13, 16, 0.92);
        --nav-border: rgba(255, 255, 255, 0.08);
        --nav-text: #f5e8e4;
        --nav-text-muted: #c7b2ad;
        --accent-orange: #ff6b4a;
        --accent-coral: #e05a36;
        --accent-glow: rgba(255, 107, 74, 0.35);
    }

    .navbar-header {
        position: sticky;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        background: var(--nav-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--nav-border);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
    }

    .navbar-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0.85rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Brand Logo */
    .nav-brand {
        display: flex;
        align-items: center;
        gap: 3px;
        text-decoration: none;
        font-size: clamp(1.15rem, 3vw, 1.35rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        transition: transform 0.2s ease;
    }

    .nav-brand:hover {
        transform: translateY(-1px);
    }

    .brand-first {
        background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .brand-dot {
        color: var(--accent-orange);
        font-size: 1.5rem;
        line-height: 1;
        text-shadow: 0 0 10px var(--accent-glow);
    }

    .brand-last {
        color: var(--nav-text);
    }

    /* Desktop Navigation */
    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .nav-links,
    .mobile-links {
        list-style: none !important;
        list-style-type: none !important;
        margin: 0;
        padding: 0;
    }

    .nav-links {
        display: flex;
        gap: 0.4rem;
        align-items: center;
    }

    .nav-item,
    .mobile-item {
        list-style: none !important;
        margin: 0;
        padding: 0;
    }

    .nav-link {
        position: relative;
        padding: 0.5rem 0.9rem;
        color: var(--nav-text-muted);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 500;
        border-radius: 9999px;
        transition: all 0.2s ease;
        white-space: nowrap;
        display: inline-block;
    }

    .nav-link:hover {
        color: var(--nav-text);
        background: rgba(255, 255, 255, 0.08);
    }

    .nav-link.active {
        color: #ffffff;
        background: rgba(255, 107, 74, 0.18);
        border: 1px solid rgba(255, 107, 74, 0.35);
        font-weight: 600;
    }

    /* CTA Button Style */
    .nav-link.cta-button {
        margin-left: 0.4rem;
        background: linear-gradient(
            135deg,
            var(--accent-coral) 0%,
            var(--accent-orange) 100%
        );
        color: #ffffff !important;
        font-weight: 600;
        padding: 0.55rem 1.15rem;
        box-shadow: 0 4px 14px rgba(224, 90, 54, 0.35);
    }

    .nav-link.cta-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(224, 90, 54, 0.5);
    }

    /* Language Switcher */
    .lang-switch {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 0.35rem 0.7rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .lang-switch:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 107, 74, 0.4);
    }

    .lang-chip {
        color: var(--nav-text-muted);
        transition: color 0.2s ease;
    }

    .lang-chip.active-lang {
        color: #ff7e5f;
    }

    .lang-divider {
        color: rgba(255, 255, 255, 0.2);
        font-size: 0.75rem;
    }

    .mobile-controls {
        display: none;
        align-items: center;
        gap: 0.75rem;
    }

    /* Mobile Toggle */
    .mobile-toggle {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 42px;
        height: 42px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        cursor: pointer;
        padding: 10px;
        z-index: 1001;
        align-items: center;
    }

    .bar {
        width: 20px;
        height: 2px;
        background-color: var(--nav-text);
        border-radius: 2px;
        transition: all 0.3s ease;
    }

    .mobile-toggle.is-active .bar-1 {
        transform: translateY(7px) rotate(45deg);
    }

    .mobile-toggle.is-active .bar-2 {
        opacity: 0;
    }

    .mobile-toggle.is-active .bar-3 {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile Nav Drawer */
    .mobile-nav {
        display: none;
        max-height: 0;
        overflow-y: auto;
        background: rgba(18, 11, 14, 0.96);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition:
            max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            padding 0.35s ease;
        border-top: 1px solid var(--nav-border);
    }

    .mobile-nav.is-open {
        max-height: 80vh;
        padding: 1rem 1.25rem 1.5rem;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .mobile-link {
        display: block;
        padding: 0.85rem 1rem;
        color: var(--nav-text-muted);
        text-decoration: none;
        font-size: 1rem;
        font-weight: 500;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

    .mobile-link:hover,
    .mobile-link.active {
        color: #ffffff;
        background: rgba(255, 107, 74, 0.18);
        padding-left: 1.25rem;
    }

    .mobile-link.mobile-cta {
        text-align: center;
        background: linear-gradient(
            135deg,
            var(--accent-coral) 0%,
            var(--accent-orange) 100%
        );
        color: #ffffff;
        font-weight: 600;
        margin-top: 0.5rem;
    }

    /* Responsive Media Queries */
    @media (max-width: 900px) {
        .desktop-nav {
            display: none;
        }

        .mobile-controls {
            display: flex;
        }

        .mobile-nav {
            display: block;
        }
    }
</style>
