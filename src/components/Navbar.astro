---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../utils/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");
const baseRoute = lang === "th" ? currentPath.replace(/^\/th/, "") || "/" : currentPath;

const navItems = [
    { name: t("nav.home"), href: lang === "th" ? "/th" : "/" },
    { name: t("nav.about"), href: lang === "th" ? "/th/about" : "/about" },
    { name: t("nav.projects"), href: lang === "th" ? "/th/projects" : "/projects" },
    { name: t("nav.competitions"), href: lang === "th" ? "/th/competitions" : "/competitions" },
    { name: t("nav.certifications"), href: lang === "th" ? "/th/certifications" : "/certifications" },
];

const contactHref = lang === "th" ? "/th/contact" : "/contact";
const targetLang = lang === "en" ? "th" : "en";
const switchPath = getLocalizedPath(pathname, targetLang);
---

<header class="site-header">
    <div class="nav-shell">
        <a href={lang === "th" ? "/th" : "/"} class="brand" aria-label="Pannet Vanicharkorl — home">
            <span class="brand-mark" aria-hidden="true">PV</span>
            <span class="brand-copy">
                <strong>Pannet Vanicharkorl</strong>
                <small>software_engineer</small>
            </span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
            <ul class="nav-links">
                {navItems.map((item) => {
                    const itemBaseHref = lang === "th" ? item.href.replace(/^\/th/, "") || "/" : item.href;
                    const isActive = baseRoute === itemBaseHref || (itemBaseHref !== "/" && baseRoute.startsWith(itemBaseHref));
                    return (
                        <li>
                            <a href={item.href} class:list={["nav-link", { active: isActive }]} aria-current={isActive ? "page" : undefined}>
                                {item.name}
                            </a>
                        </li>
                    );
                })}
            </ul>
            <a href={switchPath} class="lang-switch" aria-label={`Switch to ${targetLang.toUpperCase()}`}>{targetLang.toUpperCase()}</a>
            <a href={contactHref} class="contact-link">
                <span class="contact-dot"></span>{lang === "th" ? "ร่วมงานกัน" : "Let's talk"}
            </a>
        </nav>

        <div class="mobile-controls">
            <a href={switchPath} class="lang-switch" aria-label={`Switch to ${targetLang.toUpperCase()}`}>{targetLang.toUpperCase()}</a>
            <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
                <span></span><span></span>
            </button>
        </div>
    </div>

    <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation">
        <ul class="mobile-links">
            {navItems.map((item, index) => {
                const itemBaseHref = lang === "th" ? item.href.replace(/^\/th/, "") || "/" : item.href;
                const isActive = baseRoute === itemBaseHref || (itemBaseHref !== "/" && baseRoute.startsWith(itemBaseHref));
                return (
                    <li>
                        <a href={item.href} class:list={["mobile-link", { active: isActive }]}>
                            <span>0{index + 1}</span>{item.name}
                        </a>
                    </li>
                );
            })}
            <li><a href={contactHref} class="mobile-contact">{lang === "th" ? "ติดต่อพูดคุย" : "Start a conversation"}<span>↗</span></a></li>
        </ul>
    </nav>
</header>

<script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    const closeMenu = () => {
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.classList.remove("is-active");
        menu?.classList.remove("is-open");
    };

    toggle?.addEventListener("click", () => {
        const opening = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(opening));
        toggle.classList.toggle("is-active", opening);
        menu?.classList.toggle("is-open", opening);
    });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => event.key === "Escape" && closeMenu());
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(8, 11, 15, .82);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(18px) saturate(140%);
    }
    .nav-shell {
        width: min(calc(100% - 2rem), var(--max-width));
        min-height: 72px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
    }
    .brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--text); text-decoration: none; }
    .brand-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border: 1px solid rgba(126, 231, 135, .45);
        border-radius: 8px;
        background: var(--green-soft);
        color: var(--green);
        font: 600 .75rem var(--mono);
        box-shadow: inset 0 0 18px rgba(126, 231, 135, .06);
    }
    .brand-copy { display: flex; flex-direction: column; gap: 1px; }
    .brand-copy strong { font-size: .88rem; letter-spacing: -.015em; }
    .brand-copy small { color: var(--muted); font: 400 .65rem var(--mono); }
    .desktop-nav { display: flex; align-items: center; gap: .65rem; }
    .nav-links { display: flex; align-items: center; gap: .1rem; }
    .nav-link {
        display: inline-flex;
        padding: .55rem .68rem;
        border-radius: 7px;
        color: var(--muted);
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s ease, background .2s ease;
    }
    .nav-link:hover { color: var(--text); background: rgba(255,255,255,.04); }
    .nav-link.active { color: var(--text); background: rgba(255,255,255,.055); }
    .nav-link.active::before { content: "_"; color: var(--green); margin-right: 1px; font-family: var(--mono); }
    .lang-switch {
        display: grid;
        place-items: center;
        width: 34px;
        height: 30px;
        border: 1px solid var(--line);
        border-radius: 7px;
        color: var(--muted-strong);
        font: 600 .66rem var(--mono);
        text-decoration: none;
        transition: border-color .2s ease, color .2s ease;
    }
    .lang-switch:hover { border-color: var(--line-strong); color: var(--text); }
    .contact-link {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .58rem .9rem;
        border: 1px solid rgba(126,231,135,.32);
        border-radius: 7px;
        background: var(--green-soft);
        color: var(--green);
        font: 500 .72rem var(--mono);
        text-decoration: none;
        transition: background .2s ease, transform .2s ease;
    }
    .contact-link:hover { background: rgba(126,231,135,.16); transform: translateY(-1px); }
    .contact-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px rgba(126,231,135,.75); }
    .mobile-controls { display: none; align-items: center; gap: .55rem; }
    .menu-toggle {
        width: 38px;
        height: 34px;
        display: grid;
        place-content: center;
        gap: 6px;
        border: 1px solid var(--line);
        border-radius: 7px;
        background: transparent;
        cursor: pointer;
    }
    .menu-toggle span { display: block; width: 17px; height: 1px; background: var(--text); transition: transform .2s ease; }
    .menu-toggle.is-active span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .menu-toggle.is-active span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .mobile-nav { display: none; max-height: 0; overflow: hidden; border-top: 1px solid transparent; transition: max-height .3s ease, border-color .3s ease; }
    .mobile-nav.is-open { max-height: 520px; border-color: var(--line); }
    .mobile-links { width: min(calc(100% - 2rem), var(--max-width)); margin: 0 auto; padding: .75rem 0 1rem; }
    .mobile-link, .mobile-contact { display: flex; align-items: center; justify-content: space-between; padding: .85rem .75rem; color: var(--muted-strong); text-decoration: none; border-bottom: 1px solid var(--line); font-size: .9rem; }
    .mobile-link span { color: var(--muted); font: .65rem var(--mono); }
    .mobile-link.active { color: var(--green); }
    .mobile-contact { margin-top: .7rem; border: 1px solid rgba(126,231,135,.3); border-radius: 8px; color: var(--green); font: 500 .8rem var(--mono); }

    @media (max-width: 980px) {
        .desktop-nav { display: none; }
        .mobile-controls { display: flex; }
        .mobile-nav { display: block; }
    }
    @media (max-width: 440px) { .brand-copy small { display: none; } }
</style>
