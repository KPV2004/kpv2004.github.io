---
import { getLocalizedCollection, entrySlug } from '../../utils/content';
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations, localizePath, type Lang } from "../../utils/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const certificates = await getLocalizedCollection('certificates', lang);
---

<Layout lang={lang} title={t('meta.certifications_title')} description={t('certifications.desc')}>
  <Navbar lang={lang} />

  <main class="page-shell" id="main-content">
    <header class="page-header">
      <span class="section-tag">{t('certifications.tag')}</span>
      <h1 class="page-title">{t('certifications.title')}</h1>
      <p class="page-description">{t('certifications.desc')}</p>
    </header>

    <section class="certs-grid">
      {certificates.map((cert) => {
        const certSlug = entrySlug(cert);
        const { data } = cert;
        const detailHref = localizePath(`/certifications/${certSlug}`, lang);
        return (
          <article class="card">
            {data.image && (
              <div class="card-media">
                <img src={data.image} alt="" loading="lazy" />
              </div>
            )}
            <div class="card-body">
              <span class="meta">{data.date}</span>
              <h2 class="card-title"><a href={detailHref} class="card-link">{data.title}</a></h2>
              <span class="cert-issuer">{t('cert.issued_by')} {data.issuer}</span>
              <div class="tag-list">
                {data.skills.map((skill) => <span class="tag">{skill}</span>)}
              </div>
              <span class="text-link" aria-hidden="true">{t('card.view_details')} &rarr;</span>
            </div>
          </article>
        );
      })}
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .card-media { aspect-ratio: 16 / 10; border-bottom: 1px solid var(--border); }
  .card-title { margin-top: .5rem; }
  .cert-issuer { margin-bottom: 1rem; color: var(--text-secondary); font: var(--fs-label) var(--mono); }
  .tag-list { margin-bottom: 1.25rem; }
  .text-link { margin-top: auto; }

  @media (max-width: 420px) {
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>
