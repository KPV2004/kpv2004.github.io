---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, localizePath, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${data.title} — ${t('meta.site_name')}`} description={data.description}>
  <Navbar lang={lang} />

  <article class="page-shell page-shell--reading detail-page" id="main-content">
    <a href={localizePath('/projects', lang)} class="text-link">&larr; {t('detail.back_projects')}</a>

    <header class="detail-header">
      <span class="badge">{data.category}</span>
      <h1 class="detail-title">{data.title}</h1>
      <p class="detail-desc">{data.description}</p>

      <div class="tag-list">
        {data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>

      {(data.github || data.demo) && (
        <div class="detail-actions">
          {data.github && (
            <a href={data.github} target="_blank" rel="noopener noreferrer" class="button button-secondary">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              {t('detail.github')}
            </a>
          )}
          {data.demo && (
            <a href={data.demo} target="_blank" rel="noopener noreferrer" class="button button-primary">
              {t('detail.live')} &rarr;
            </a>
          )}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <Footer lang={lang} />
</Layout>
