---
import { getLocalizedCollection, entrySlug } from '../../utils/content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, localizePath, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const competitions = await getLocalizedCollection('competitions', lang);

// Gold is reserved for placings; participation gets the neutral badge.
const isParticipation = (award: string) => /participant|ผู้เข้าร่วม/i.test(award);
---

<Layout lang={lang} title={t('meta.competitions_title')} description={t('competitions.desc')}>
  <Navbar lang={lang} />

  <main class="page-shell" id="main-content">
    <header class="page-header">
      <span class="section-tag">{t('competitions.tag')}</span>
      <h1 class="page-title">{t('competitions.title')}</h1>
      <p class="page-description">{t('competitions.desc')}</p>
    </header>

    <section class="competitions-list">
      {competitions.map((comp) => {
        const compSlug = entrySlug(comp);
        const { data } = comp;
        const detailHref = localizePath(`/competitions/${compSlug}`, lang);
        return (
          <article class="card comp-card">
            {data.image && (
              <div class="card-media">
                <img src={data.image} alt="" loading="lazy" />
              </div>
            )}
            <div class="card-body">
              <div class="comp-header">
                <span class:list={['badge', isParticipation(data.award) ? 'badge--neutral' : 'badge--award']}>
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
                  </svg>
                  {data.award}
                </span>
                <span class="meta">{data.date}</span>
              </div>

              <h2 class="card-title"><a href={detailHref} class="card-link">{data.title}</a></h2>
              <span class="comp-category">{data.category}</span>
              <p class="card-desc">{data.description}</p>

              <div class="comp-bottom">
                <div class="tag-list">
                  {data.technologies.map((tech) => <span class="tag">{tech}</span>)}
                </div>
                <span class="text-link" aria-hidden="true">{t('card.view_details')} &rarr;</span>
              </div>
            </div>
          </article>
        );
      })}
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .competitions-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .comp-card { display: grid; grid-template-columns: 300px 1fr; }
  /* The image never sizes the row, so portrait scans can't stretch a card. */
  .comp-card .card-media { min-height: 225px; border-right: 1px solid var(--border); }
  .comp-card .card-media img { position: absolute; inset: 0; }
  .comp-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; }
  .comp-category { display: block; margin-bottom: .85rem; color: var(--info); font-size: .9375rem; font-weight: 500; }
  .card-desc { flex-grow: 1; }
  .comp-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }

  @media (max-width: 768px) {
    .comp-card { grid-template-columns: 1fr; }
    .comp-card .card-media { min-height: 0; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--border); }
  }
</style>
