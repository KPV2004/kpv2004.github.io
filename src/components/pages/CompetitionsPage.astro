---
import { getLocalizedCollection, entrySlug } from '../../utils/content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, localizePath, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const competitions = await getLocalizedCollection('competitions', lang);
---

<Layout lang={lang} title={t('meta.competitions_title')} description={t('competitions.desc')}>
  <Navbar lang={lang} />

  <section class="page-header" id="main-content">
    <div class="header-container">
      <span class="section-tag">{t('competitions.tag')}</span>
      <h1 class="page-title">{t('competitions.title')}</h1>
      <p class="page-description">
        {t('competitions.desc')}
      </p>
    </div>
  </section>

  <section class="competitions-section">
    <div class="competitions-container">
      <div class="competitions-list">
        {competitions.map((comp) => {
          const compSlug = entrySlug(comp);
          const { data } = comp;
          const detailHref = localizePath(`/competitions/${compSlug}`, lang);
          return (
            <div class="comp-card">
              {data.image && (
                <a href={detailHref} class="comp-image-wrapper">
                  <img src={data.image} alt={data.title} loading="lazy" class="comp-image" />
                </a>
              )}
              <div class="comp-content">
                <div class="comp-header">
                  <div class="award-badge">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
                    </svg>
                    {data.award}
                  </div>
                  <span class="comp-date">{data.date}</span>
                </div>

                <h2 class="comp-title">{data.title}</h2>
                <span class="comp-category">{data.category}</span>

                <p class="comp-desc">{data.description}</p>

                <div class="comp-bottom">
                  <div class="tech-stack">
                    {data.technologies.map(tech => (
                      <span class="tech-chip">{tech}</span>
                    ))}
                  </div>

                  <a href={detailHref} class="details-link">
                    {t('card.view_details')} &rarr;
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .page-header {
    padding: 5rem 1.75rem 3rem;
    text-align: center;
    background: radial-gradient(circle at top, rgba(126, 231, 135, 0.15) 0%, rgba(0,0,0,0) 70%);
  }

  .header-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-tag {
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #7ee787;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.8rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .page-description {
    font-size: 1.15rem;
    color: #b7c2cd;
    line-height: 1.6;
    margin: 0;
  }

  .competitions-section {
    padding: 3rem 1.75rem 5rem;
  }

  .competitions-container {
    max-width: 950px;
    margin: 0 auto;
  }

  .competitions-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .comp-card {
    background: rgba(17, 23, 31, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 280px 1fr;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .comp-card:hover {
    transform: translateY(-4px);
    border-color: rgba(126, 231, 135, 0.4);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
  }

  .comp-image-wrapper {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 220px;
    overflow: hidden;
  }

  .comp-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .comp-card:hover .comp-image {
    transform: scale(1.05);
  }

  .comp-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .comp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .award-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffd700;
    background: rgba(255, 215, 0, 0.12);
    border: 1px solid rgba(255, 215, 0, 0.3);
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }

  .comp-date {
    font-size: 0.88rem;
    color: #8e9ba9;
  }

  .comp-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.3rem 0;
  }

  .comp-category {
    font-size: 0.88rem;
    color: #79c0ff;
    font-weight: 500;
    display: block;
    margin-bottom: 0.85rem;
  }

  .comp-desc {
    font-size: 0.95rem;
    color: #b7c2cd;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .comp-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-chip {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.05);
    color: #edf4f8;
    padding: 0.25rem 0.65rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .details-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: #79c0ff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .details-link:hover {
    color: #9aefa1;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .comp-card { grid-template-columns: 1fr; }
    .comp-image-wrapper { height: 200px; }
  }
</style>
