---
import { getLocalizedCollection, entrySlug } from '../../utils/content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, localizePath, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getLocalizedCollection('projects', lang);
---

<Layout lang={lang} title={t('meta.projects_title')} description={t('projects.desc')}>
  <Navbar lang={lang} />

  <main class="page-shell" id="main-content">
    <header class="page-header">
      <span class="section-tag">{t('projects.tag')}</span>
      <h1 class="page-title">{t('projects.title')}</h1>
      <p class="page-description">{t('projects.desc')}</p>
    </header>

    <section class="projects-grid">
      {projects.map((project) => {
        const projectSlug = entrySlug(project);
        const { data } = project;
        const detailHref = localizePath(`/projects/${projectSlug}`, lang);
        return (
          <article class="card">
            {data.image && (
              <div class="card-media">
                <Image src={data.image} alt="" widths={[400, 800]} sizes="(max-width: 420px) 100vw, 380px" class:list={{ 'is-portrait': data.image.height > data.image.width }} />
              </div>
            )}
            <div class="card-body">
              <span class="badge">{data.category}</span>
              <h2 class="card-title"><a href={detailHref} class="card-link">{data.title}</a></h2>
              <p class="card-desc">{data.description}</p>
              <div class="tag-list">
                {data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <div class="card-actions">
                <a href={detailHref} class="button button-primary" tabindex="-1" aria-hidden="true">{t('card.case_study')} &rarr;</a>
                {data.github && (
                  <a href={data.github} target="_blank" rel="noopener noreferrer" class="button button-secondary button-icon" title={t('card.source_code')} aria-label={`${t('card.source_code')}: ${data.title}`}>
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .card-media { aspect-ratio: 16 / 9; border-bottom: 1px solid var(--border); }
  .card-desc { flex-grow: 1; }
  .card-actions { display: flex; gap: .75rem; margin-top: 1.5rem; }
  .card-actions .button-primary { flex-grow: 1; }

  @media (max-width: 420px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
