---
import { getLocalizedCollection, entrySlug } from '../../utils/content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, localizePath, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getLocalizedCollection('projects', lang);
---

<Layout lang={lang} title={t('meta.projects_title')} description={t('projects.desc')}>
  <Navbar lang={lang} />

  <section class="page-header" id="main-content">
    <div class="header-container">
      <span class="section-tag">{t('projects.tag')}</span>
      <h1 class="page-title">{t('projects.title')}</h1>
      <p class="page-description">
        {t('projects.desc')}
      </p>
    </div>
  </section>

  <section class="projects-section">
    <div class="projects-container">
      <div class="projects-grid">
        {projects.map((project) => {
          const projectSlug = entrySlug(project);
          const { data } = project;
          const detailHref = localizePath(`/projects/${projectSlug}`, lang);
          return (
            <div class="project-card">
              {data.image && (
                <a href={detailHref} class="card-image-wrapper">
                  <img
                    src={data.image}
                    alt={data.title}
                    loading="lazy"
                    class:list={['card-image', { 'card-image--top': projectSlug === 'tiawpao' }]}
                  />
                  <div class="image-overlay"></div>
                </a>
              )}
              <div class="card-content">
                <div class="card-top">
                  <span class="category-badge">{data.category}</span>
                </div>
                <h2 class="project-title">{data.title}</h2>
                <p class="project-desc">{data.description}</p>
                
                <div class="tags-container">
                  {data.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>

                <div class="card-actions">
                  <a href={detailHref} class="action-btn details-btn">
                    {t('card.case_study')} &rarr;
                  </a>
                  {data.github && (
                    <a href={data.github} target="_blank" rel="noopener noreferrer" class="action-btn github-btn" title={t('card.source_code')} aria-label={`${t('card.source_code')}: ${data.title}`}>
                      <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .page-header {
    padding: 5rem 1.75rem 3rem;
    text-align: center;
    background: radial-gradient(circle at top, rgba(126, 231, 135, 0.15) 0%, rgba(0,0,0,0) 70%);
  }

  .header-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-tag {
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #7ee787;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.8rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .page-description {
    font-size: 1.15rem;
    color: #b7c2cd;
    line-height: 1.6;
    margin: 0;
  }

  /* Projects Grid */
  .projects-section {
    padding: 3rem 1.75rem 5rem;
  }

  .projects-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background: rgba(17, 23, 31, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
    backdrop-filter: blur(12px);
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: rgba(126, 231, 135, 0.4);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 190px;
    overflow: hidden;
    display: block;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card-image--top {
    object-position: top center;
  }

  .project-card:hover .card-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17, 23, 31, 0.9) 0%, transparent 60%);
  }

  .card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .category-badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: #d2a8ff;
    background: rgba(254, 180, 123, 0.12);
    padding: 0.25rem 0.8rem;
    border-radius: 9999px;
  }

  .project-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    margin: 1rem 0 0.6rem 0;
  }

  .project-desc {
    font-size: 0.95rem;
    color: #8e9ba9;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .tag-pill {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.05);
    color: #b7c2cd;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .card-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1.1rem;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .details-btn {
    background: linear-gradient(135deg, #57ab5a 0%, #7ee787 100%);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(126, 231, 135, 0.35);
    flex-grow: 1;
    justify-content: center;
  }

  .details-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(126, 231, 135, 0.5);
  }

  .github-btn {
    background: rgba(255, 255, 255, 0.06);
    color: #edf4f8;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.65rem;
  }

  .github-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
