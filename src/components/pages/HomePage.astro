---
import { getLocalizedCollection, entrySlug } from "../../utils/content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations, type Lang } from "../../utils/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [allProjects, competitions, certificates] = await Promise.all([
  getLocalizedCollection("projects", lang),
  getLocalizedCollection("competitions", lang),
  getLocalizedCollection("certificates", lang),
]);

const projectPriority = ["tiawpao", "cyberarena", "ku-schedule"];
const projects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => {
    const aRank = projectPriority.indexOf(entrySlug(a));
    const bRank = projectPriority.indexOf(entrySlug(b));
    return (aRank === -1 ? 99 : aRank) - (bRank === -1 ? 99 : bRank);
  })
  .slice(0, 3);

const skills = [
  { label: "01 / Languages", items: ["TypeScript", "JavaScript", "Go", "Python", "Java", "C++"] },
  { label: "02 / Product", items: ["React", "Next.js", "React Native", "Astro", "Tailwind CSS"] },
  { label: "03 / Systems", items: ["Node.js", "GoFiber", "PostgreSQL", "WebSocket", "Firebase"] },
  { label: "04 / ERP", items: ["Microsoft Dynamics AX", "ERP Integration", "API Integration"] },
  { label: "05 / Workflow", items: ["Git", "Docker", "CI/CD", "Figma", "Postman"] },
];

const base = lang === "th" ? "/th" : "";
const copy = lang === "th" ? {
  eyebrow: "Full-Stack Engineer · ERP (Dynamics AX)",
  titleA: "เปลี่ยนปัญหาที่ซับซ้อน",
  titleB: "ให้เป็นซอฟต์แวร์ที่ใช้งานได้จริง",
  subtitle: "ผมปานเนตร วิศวกรซอฟต์แวร์สาย Full Stack ที่ชอบสร้างผลิตภัณฑ์ดิจิทัลให้รวดเร็ว เชื่อถือได้ และเข้าใจง่าย ตั้งแต่หน้าจอจนถึงระบบหลังบ้าน",
  location: "กรุงเทพมหานคร ประเทศไทย",
  open: "พร้อมรับโอกาสใหม่",
  work: "ดูโปรเจกต์",
  profile: "GitHub Profile",
  experience: "ปีประสบการณ์",
  shipped: "โปรเจกต์ที่พัฒนา",
  achieved: "การแข่งขัน",
  sectionKicker: "selected_work",
  workTitle: "ซอฟต์แวร์ที่ออกแบบมาเพื่อแก้ปัญหาจริง",
  workDesc: "ตั้งแต่แอปวางแผนท่องเที่ยวด้วย AI ไปจนถึงเกมความปลอดภัยไซเบอร์ แต่ละโปรเจกต์แสดงทั้งแนวคิด การออกแบบ และการลงมือพัฒนา",
  caseStudy: "ดูรายละเอียด",
  liveDemo: "เปิดเว็บไซต์",
  stackKicker: "engineering_toolkit",
  stackTitle: "เทคโนโลยีที่ใช้ส่งมอบงาน",
  approachKicker: "how_i_work",
  approachTitle: "คิดเป็นระบบ สร้างเพื่อผู้ใช้",
  approaches: [
    ["Product minded", "เริ่มจากปัญหาของผู้ใช้ แล้วค่อยเลือกเทคโนโลยีที่เหมาะสมกับงาน"],
    ["Full-stack ownership", "ดูแลได้ตั้งแต่ UX, API, ฐานข้อมูล ไปจนถึงการ deploy และปรับปรุงระบบ"],
    ["Built to evolve", "เขียนโค้ดที่อ่านง่าย แยกส่วนชัดเจน และพร้อมต่อยอดเมื่อผลิตภัณฑ์เติบโต"],
  ],
  ctaTag: "พร้อมสร้างสิ่งต่อไป",
  ctaTitle: "มีโจทย์ที่น่าสนใจ? มาคุยกันครับ",
  ctaDesc: "เปิดรับตำแหน่ง Software Engineer, งานพัฒนาโปรดักต์ และการร่วมสร้างโปรเจกต์ที่มีผลลัพธ์จริง",
  ctaButton: "เริ่มพูดคุย",
} : {
  eyebrow: "Full-Stack Engineer · ERP (Dynamics AX)",
  titleA: "I turn complex problems",
  titleB: "into software that works.",
  subtitle: "I’m Pannet, a full-stack software engineer focused on building digital products that feel fast, stay reliable, and make sense—from interface to infrastructure.",
  location: "Bangkok, Thailand",
  open: "Open to opportunities",
  work: "View my work",
  profile: "GitHub Profile",
  experience: "year experience",
  shipped: "projects shipped",
  achieved: "competitions",
  sectionKicker: "selected_work",
  workTitle: "Software built around real problems.",
  workDesc: "From AI-assisted travel planning to cybersecurity education, each project shows the product thinking and engineering behind the interface.",
  caseStudy: "View case study",
  liveDemo: "Live product",
  stackKicker: "engineering_toolkit",
  stackTitle: "The tools I use to ship.",
  approachKicker: "how_i_work",
  approachTitle: "Systems thinking, product focus.",
  approaches: [
    ["Product minded", "Start with the user’s problem, then choose the simplest technology that can solve it well."],
    ["Full-stack ownership", "Work comfortably across UX, APIs, data models, deployment, and the details between them."],
    ["Built to evolve", "Write clear, modular software that teammates can understand and products can grow on."],
  ],
  ctaTag: "Available for the next build",
  ctaTitle: "Have an interesting problem? Let’s talk.",
  ctaDesc: "I’m open to software engineering roles, product collaborations, and teams building things that create real value.",
  ctaButton: "Start a conversation",
};
---

<Layout title="Pannet Vanicharkorl — Software Engineer">
  <Navbar />

  <main id="main-content">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span>&gt;_</span>{copy.eyebrow}</div>
          <h1>{copy.titleA}<br /><em>{copy.titleB}</em></h1>
          <p class="hero-description">{copy.subtitle}</p>

          <div class="availability" aria-label={`${copy.location}, ${copy.open}`}>
            <span class="status-light"></span>
            <span>{copy.open}</span>
            <i></i>
            <span>{copy.location}</span>
          </div>

          <div class="hero-actions">
            <a href={`${base}/projects`} class="button button-primary">{copy.work}<span>↗</span></a>
            <a href="https://github.com/KPV2004" target="_blank" rel="noopener noreferrer" class="button button-secondary">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              {copy.profile}
            </a>
          </div>
        </div>

        <div class="code-window" aria-label="Developer profile code preview">
          <div class="window-bar">
            <div class="window-dots"><span></span><span></span><span></span></div>
            <span>pannet.ts</span>
            <span class="branch">main</span>
          </div>
          <div class="code-body">
            <div><span class="ln">01</span><span class="purple">const</span> <span class="blue">engineer</span> = <span>{`{`}</span></div>
            <div><span class="ln">02</span>&nbsp;&nbsp;name: <span class="green">"Pannet Vanicharkorl"</span>,</div>
            <div><span class="ln">03</span>&nbsp;&nbsp;role: <span class="green">"Software Engineer"</span>,</div>
            <div><span class="ln">04</span>&nbsp;&nbsp;focus: [</div>
            <div><span class="ln">05</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="green">"product engineering"</span>,</div>
            <div><span class="ln">06</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="green">"full-stack systems"</span>,</div>
            <div><span class="ln">07</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="green">"cybersecurity"</span></div>
            <div><span class="ln">08</span>&nbsp;&nbsp;],</div>
            <div><span class="ln">09</span>&nbsp;&nbsp;ships: <span class="purple">true</span>,</div>
            <div><span class="ln">10</span>&nbsp;&nbsp;curious: <span class="purple">always</span></div>
            <div><span class="ln">11</span><span>{`}`}</span>;</div>
            <div class="terminal-line"><span class="ln">12</span><span class="prompt">$</span> engineer.build(<span class="green">"what matters"</span>)<span class="cursor"></span></div>
          </div>
          <div class="window-footer"><span>TypeScript</span><span>UTF-8&nbsp;&nbsp;Ln 12, Col 36</span></div>
        </div>
      </div>

      <div class="metrics">
        <div><strong>1+</strong><span>{copy.experience}</span></div>
        <div><strong>{allProjects.length}+</strong><span>{copy.shipped}</span></div>
        <div><strong>{competitions.length}</strong><span>{copy.achieved}</span></div>
        <div class="metric-note"><span class="commit-icon">●</span><p><b>{certificates.length} credentials</b><br />always learning, always shipping</p></div>
      </div>
    </section>

    <section class="work-section section-shell">
      <div class="section-intro">
        <div><span class="kicker">// {copy.sectionKicker}</span><h2>{copy.workTitle}</h2></div>
        <p>{copy.workDesc}</p>
      </div>

      <div class="project-list">
        {projects.map((project, index) => {
          const slug = entrySlug(project);
          const detailLink = `${base}/projects/${slug}`;
          return (
            <article class="project-row">
              <a href={detailLink} class="project-visual" aria-label={`View ${project.data.title}`}>
                <img src={project.data.image} alt={`${project.data.title} interface`} loading="lazy" />
                <span class="project-number">0{index + 1}</span>
              </a>
              <div class="project-info">
                <div class="project-meta"><span>{project.data.category}</span><span>{project.data.date || "2025"}</span></div>
                <h3><a href={detailLink}>{project.data.title}</a></h3>
                <p>{project.data.description}</p>
                <div class="project-tags">{project.data.tags.slice(0, 5).map((tag) => <span>{tag}</span>)}</div>
                <div class="project-links">
                  <a href={detailLink}>{copy.caseStudy}<span>→</span></a>
                  {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">{copy.liveDemo}<span>↗</span></a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <a class="all-projects" href={`${base}/projects`}><span>[ {String(allProjects.length).padStart(2, "0")} ]</span>{t("section.view_all_projects")}</a>
    </section>

    <section class="approach section-shell">
      <div class="section-intro compact">
        <div><span class="kicker">// {copy.approachKicker}</span><h2>{copy.approachTitle}</h2></div>
      </div>
      <div class="approach-grid">
        {copy.approaches.map((item, index) => (
          <article><span>0{index + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>
        ))}
      </div>
    </section>

    <section class="stack-section section-shell">
      <div class="stack-heading"><span class="kicker">// {copy.stackKicker}</span><h2>{copy.stackTitle}</h2></div>
      <div class="stack-list">
        {skills.map((group) => (
          <div class="stack-row"><h3>{group.label}</h3><div>{group.items.map((item) => <span>{item}</span>)}</div></div>
        ))}
      </div>
    </section>

    <section class="cta section-shell">
      <div class="cta-card">
        <span class="cta-status"><i></i>{copy.ctaTag}</span>
        <h2>{copy.ctaTitle}</h2>
        <p>{copy.ctaDesc}</p>
        <a href={`${base}/contact`} class="button button-primary">{copy.ctaButton}<span>↗</span></a>
        <div class="cta-decoration" aria-hidden="true">{`{ build(); }`}</div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .section-shell { width: min(calc(100% - 2.5rem), var(--max-width)); margin-inline: auto; }
  .hero { width: min(calc(100% - 2.5rem), var(--max-width)); margin: 0 auto; padding: clamp(4rem, 9vw, 8rem) 0 4rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr); align-items: center; gap: clamp(2.5rem, 6vw, 6.5rem); }
  .eyebrow { display: flex; align-items: center; gap: .65rem; margin-bottom: 1.3rem; color: var(--muted-strong); font: 500 .72rem var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .eyebrow span { color: var(--green); }
  .hero h1 { max-width: 720px; margin: 0; color: var(--text); font-size: clamp(2.8rem, 5.4vw, 5.25rem); font-weight: 700; line-height: 1.04; letter-spacing: -.065em; }
  .hero h1 em { color: var(--green); font-style: normal; }
  .hero-description { max-width: 650px; margin: 1.5rem 0 1.25rem; color: var(--muted-strong); font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.75; }
  .availability { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; color: var(--muted); font: 400 .7rem var(--mono); }
  .availability i { width: 1px; height: 13px; background: var(--line-strong); }
  .status-light { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 11px rgba(126,231,135,.75); animation: glow 2.2s ease-in-out infinite; }
  @keyframes glow { 50% { opacity: .45; } }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 44px; padding: .72rem 1.05rem; border: 1px solid transparent; border-radius: 8px; font: 600 .78rem var(--mono); text-decoration: none; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .button-primary { background: var(--green); color: #071009; }
  .button-primary:hover { background: #9aefa1; }
  .button-secondary { border-color: var(--line-strong); background: rgba(255,255,255,.025); color: var(--muted-strong); }
  .button-secondary:hover { border-color: rgba(121,192,255,.35); color: var(--text); }
  .code-window { overflow: hidden; border: 1px solid var(--line-strong); border-radius: 12px; background: rgba(13,18,24,.92); box-shadow: 0 34px 90px rgba(0,0,0,.32); transform: rotate(1deg); }
  .window-bar, .window-footer { display: flex; align-items: center; height: 38px; border-bottom: 1px solid var(--line); background: #111820; color: var(--muted); font: 400 .62rem var(--mono); }
  .window-bar { justify-content: space-between; padding: 0 .8rem; }
  .window-dots { display: flex; gap: 5px; }
  .window-dots span { width: 7px; height: 7px; border-radius: 50%; background: #34404d; }
  .window-dots span:first-child { background: #f47067; }.window-dots span:nth-child(2) { background: #d29922; }.window-dots span:last-child { background: #57ab5a; }
  .branch::before { content: "⌘ "; }
  .code-body { padding: 1.3rem .85rem 1.4rem; color: #d5dbe1; font: 400 clamp(.65rem, 1.05vw, .78rem)/1.9 var(--mono); white-space: nowrap; }
  .ln { display: inline-block; width: 2.1rem; color: #465361; user-select: none; }.purple { color: var(--purple); }.blue { color: var(--blue); }.green { color: var(--green); }
  .terminal-line { margin-top: .55rem; padding-top: .55rem; border-top: 1px solid var(--line); }.prompt { color: var(--green); margin-right: .5rem; }.cursor { display: inline-block; width: 6px; height: 1em; margin-left: 4px; background: var(--green); vertical-align: -2px; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .window-footer { justify-content: space-between; height: 28px; padding: 0 .8rem; border-top: 1px solid var(--line); border-bottom: 0; color: #607080; }
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr) 1.45fr; margin-top: clamp(3.5rem, 7vw, 6rem); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .metrics > div { min-height: 96px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--line); }
  .metrics > div:last-child { border-right: 0; }
  .metrics strong { color: var(--text); font: 600 1.65rem var(--mono); }.metrics span { color: var(--muted); font: .65rem var(--mono); text-transform: uppercase; letter-spacing: .05em; }
  .metrics .metric-note { flex-direction: row; align-items: center; gap: .8rem; }.metric-note .commit-icon { color: var(--green); font-size: .8rem; }.metric-note p { margin: 0; color: var(--muted); font: .66rem/1.65 var(--mono); }.metric-note b { color: var(--muted-strong); font-weight: 500; }
  .work-section, .approach, .stack-section { padding-top: clamp(5rem, 10vw, 9rem); }
  .section-intro { display: grid; grid-template-columns: 1.15fr .85fr; align-items: end; gap: 3rem; margin-bottom: 2.5rem; }
  .section-intro.compact { display: block; }
  .kicker { display: block; margin-bottom: .8rem; color: var(--green); font: 500 .68rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .section-intro h2, .stack-heading h2 { max-width: 680px; margin: 0; color: var(--text); font-size: clamp(2rem, 4vw, 3.45rem); line-height: 1.08; letter-spacing: -.05em; }
  .section-intro > p { max-width: 460px; margin: 0 0 .2rem; color: var(--muted); font-size: .94rem; line-height: 1.75; }
  .project-list { border-top: 1px solid var(--line-strong); }
  .project-row { display: grid; grid-template-columns: minmax(320px, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 5rem); padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .project-visual { position: relative; display: block; aspect-ratio: 16/10; overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .project-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,11,15,.3), transparent 55%); }
  .project-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease, filter .5s ease; }
  .project-row:hover img { transform: scale(1.025); }
  .project-number { position: absolute; z-index: 1; left: .75rem; bottom: .7rem; display: grid; place-items: center; width: 30px; height: 26px; border: 1px solid rgba(255,255,255,.2); border-radius: 5px; background: rgba(8,11,15,.75); color: var(--green); font: .65rem var(--mono); backdrop-filter: blur(8px); }
  .project-info { display: flex; flex-direction: column; justify-content: center; padding-right: clamp(0rem, 3vw, 3rem); }
  .project-meta { display: flex; justify-content: space-between; padding-bottom: .75rem; border-bottom: 1px solid var(--line); color: var(--muted); font: .64rem var(--mono); text-transform: uppercase; }
  .project-info h3 { margin: 1rem 0 .7rem; font-size: clamp(1.65rem, 3vw, 2.55rem); letter-spacing: -.045em; }.project-info h3 a { color: var(--text); text-decoration: none; }
  .project-info p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .project-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.2rem; }.project-tags span { padding: .3rem .5rem; border: 1px solid var(--line); border-radius: 5px; background: rgba(255,255,255,.02); color: var(--muted-strong); font: .6rem var(--mono); }
  .project-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.4rem; }.project-links a { display: inline-flex; align-items: center; gap: .45rem; color: var(--green); font: 500 .68rem var(--mono); text-decoration: none; }.project-links a:last-child { color: var(--blue); }.project-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .all-projects { display: inline-flex; align-items: center; gap: .65rem; margin-top: 1.4rem; color: var(--muted-strong); font: 500 .72rem var(--mono); text-decoration: none; }.all-projects span { color: var(--green); }.all-projects:hover { color: var(--text); }
  .approach-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.4rem; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .approach-grid article { padding: 1.75rem; border-right: 1px solid var(--line); }.approach-grid article:last-child { border-right: 0; }.approach-grid article > span { color: var(--green); font: .63rem var(--mono); }.approach-grid h3 { margin: 2.5rem 0 .7rem; color: var(--text); font-size: 1.15rem; }.approach-grid p { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.7; }
  .stack-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .stack-heading { position: sticky; top: 110px; }
  .stack-list { border-top: 1px solid var(--line-strong); }
  .stack-row { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }.stack-row h3 { margin: 0 0 .9rem; color: var(--muted); font: 500 .64rem var(--mono); text-transform: uppercase; }.stack-row > div { display: flex; flex-wrap: wrap; gap: .55rem; }.stack-row span { padding: .42rem .65rem; border: 1px solid var(--line); border-radius: 6px; color: var(--muted-strong); font: .67rem var(--mono); transition: border-color .2s ease, color .2s ease; }.stack-row span:hover { border-color: rgba(126,231,135,.35); color: var(--green); }
