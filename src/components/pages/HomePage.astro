---
import { getLocalizedCollection, entrySlug } from "../../utils/content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations, localizePath, type Lang } from "../../utils/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [allProjects, competitions, certificates] = await Promise.all([
  getLocalizedCollection("projects", lang),
  getLocalizedCollection("competitions", lang),
  getLocalizedCollection("certificates", lang),
]);

const projectPriority = ["tiawpao", "cyberarena", "ku-schedule"];
const projects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => {
    const aRank = projectPriority.indexOf(entrySlug(a));
    const bRank = projectPriority.indexOf(entrySlug(b));
    return (aRank === -1 ? 99 : aRank) - (bRank === -1 ? 99 : bRank);
  })
  .slice(0, 3);

const skills = [
  { label: `01 / ${t("skills.languages")}`, items: ["TypeScript", "JavaScript", "Go", "Python", "Java", "C++"] },
  { label: `02 / ${t("skills.product")}`, items: ["React", "Next.js", "React Native", "Astro", "Tailwind CSS"] },
  { label: `03 / ${t("skills.systems")}`, items: ["Node.js", "GoFiber", "PostgreSQL", "WebSocket", "Firebase"] },
  { label: `04 / ${t("skills.erp")}`, items: ["Microsoft Dynamics AX", "ERP Integration", "API Integration"] },
  { label: `05 / ${t("skills.workflow")}`, items: ["Git", "Docker", "CI/CD", "Figma", "Postman"] },
];

const approaches = [
  [t("section.approach1_title"), t("section.approach1_desc")],
  [t("section.approach2_title"), t("section.approach2_desc")],
  [t("section.approach3_title"), t("section.approach3_desc")],
];

const href = (path: string) => localizePath(path, lang);

// Thai has no spaces and the browser's dictionary splits compounds such as
// ซับ|ซ้อน or ใช้|งาน, so the hero only breaks between these phrases.
const keepTogether = ["เปลี่ยนปัญหา", "ที่ซับซ้อน", "ให้เป็นซอฟต์แวร์", "ที่ใช้งานได้จริง"];
const keepPattern = new RegExp(`(${keepTogether.join("|")})`);
const phrases = (text: string) =>
  text.split(keepPattern).filter(Boolean).map((part) => ({ part, nowrap: keepTogether.includes(part) }));
---

<Layout lang={lang} title={t("meta.default_title")} description={t("meta.default_description")}>
  <Navbar lang={lang} />

  <main id="main-content">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span>&gt;_</span>{t("hero.eyebrow")}</div>
          <h1>
            {phrases(t("hero.title_pre")).map(({ part, nowrap }) => (nowrap ? <span class="nowrap">{part}</span> : part))}
            <br />
            <em>{phrases(t("hero.title_highlight")).map(({ part, nowrap }) => (nowrap ? <span class="nowrap">{part}</span> : part))}</em>
          </h1>
          <p class="hero-description">{t("hero.subtitle")}</p>

          <div class="availability" aria-label={`${t("hero.location")}, ${t("hero.status")}`}>
            <span class="status-light"></span>
            <span>{t("hero.status")}</span>
            <i></i>
            <span>{t("hero.location")}</span>
          </div>

          <div class="hero-actions">
            <a href={href("/projects")} class="button button-primary">{t("hero.explore")}<span>↗</span></a>
            <a href="https://github.com/KPV2004" target="_blank" rel="noopener noreferrer" class="button button-secondary">
              <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              {t("hero.github")}
            </a>
          </div>
        </div>

        <div class="code-window" aria-label={t("hero.code_label")}>
          <div class="window-bar">
            <div class="window-dots"><span></span><span></span><span></span></div>
            <span>pannet.ts</span>
            <span class="branch">main</span>
          </div>
          <div class="code-body">
            <div><span class="ln">01</span><span class="purple">const</span> <span class="blue">engineer</span> = <span>{`{`}</span></div>
            <div><span class="ln">02</span>&nbsp;&nbsp;name: <span class="green">"Pannet Vanicharkorl"</span>,</div>
            <div><span class="ln">03</span>&nbsp;&nbsp;role: <span class="green">"Software Engineer"</span>,</div>
            <div><span class="ln">04</span>&nbsp;&nbsp;focus: [</div>
            <div><span class="ln">05</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="green">"product engineering"</span>,</div>
            <div><span class="ln">06</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="green">"full-stack systems"</span>,</div>
            <div><span class="ln">07</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="green">"cybersecurity"</span></div>
            <div><span class="ln">08</span>&nbsp;&nbsp;],</div>
            <div><span class="ln">09</span>&nbsp;&nbsp;ships: <span class="purple">true</span>,</div>
            <div><span class="ln">10</span>&nbsp;&nbsp;curious: <span class="purple">always</span></div>
            <div><span class="ln">11</span><span>{`}`}</span>;</div>
            <div class="terminal-line"><span class="ln">12</span><span class="prompt">$</span> engineer.build(<span class="green">"what matters"</span>)<span class="cursor"></span></div>
          </div>
          <div class="window-footer"><span>TypeScript</span><span>UTF-8&nbsp;&nbsp;Ln 12, Col 36</span></div>
        </div>
      </div>

      <div class="metrics">
        <div><strong>1</strong><span>{t("hero.exp")}</span></div>
        <div><strong>{allProjects.length}</strong><span>{t("hero.projects_count")}</span></div>
        <div><strong>{competitions.length}</strong><span>{t("hero.awards_count")}</span></div>
        <div class="metric-note"><span class="commit-icon">●</span><p><b>{certificates.length} {t("hero.credentials")}</b><br />{t("hero.learning")}</p></div>
      </div>
    </section>

    <section class="work-section section-shell">
      <div class="section-intro">
        <div><span class="kicker">// selected_work</span><h2>{t("section.projects_title")}</h2></div>
        <p>{t("section.projects_desc")}</p>
      </div>

      <div class="project-list">
        {projects.map((project, index) => {
          const slug = entrySlug(project);
          const detailLink = href(`/projects/${slug}`);
          return (
            <article class="project-row">
              <a href={detailLink} class="project-visual" aria-label={`${t("section.view_project")} ${project.data.title}`}>
                {project.data.image && (
                  <Image
                    src={project.data.image}
                    alt={`${project.data.title} ${t("section.project_image_alt")}`}
                    widths={[560, 1120]}
                    sizes="(max-width: 680px) 100vw, 560px"
                    class:list={{ "is-portrait": project.data.image.height > project.data.image.width }}
                  />
                )}
                <span class="project-number">0{index + 1}</span>
              </a>
              <div class="project-info">
                <div class="project-meta"><span>{project.data.category}</span><span>{project.data.date || "2025"}</span></div>
                <h3><a href={detailLink}>{project.data.title}</a></h3>
                <p>{project.data.description}</p>
                <div class="project-tags">{project.data.tags.slice(0, 5).map((tag) => <span>{tag}</span>)}</div>
                <div class="project-links">
                  <a href={detailLink}>{t("card.case_study")}<span>→</span></a>
                  {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">{t("section.live_demo")}<span>↗</span></a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <a class="all-projects" href={href("/projects")}><span>[ {String(allProjects.length).padStart(2, "0")} ]</span>{t("section.view_all_projects")}</a>
    </section>

    <section class="approach section-shell">
      <div class="section-intro compact">
        <div><span class="kicker">// how_i_work</span><h2>{t("section.approach_title")}</h2></div>
      </div>
      <div class="approach-grid">
        {approaches.map((item, index) => (
          <article><span>0{index + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>
        ))}
      </div>
    </section>

    <section class="stack-section section-shell">
      <div class="stack-heading"><span class="kicker">// engineering_toolkit</span><h2>{t("section.tech_stack")}</h2></div>
      <div class="stack-list">
        {skills.map((group) => (
          <div class="stack-row"><h3>{group.label}</h3><div>{group.items.map((item) => <span>{item}</span>)}</div></div>
        ))}
      </div>
    </section>

    <section class="cta section-shell">
      <div class="cta-card">
        <span class="cta-status"><i></i>{t("section.cta_tag")}</span>
        <h2>{t("section.cta_title")}</h2>
        <p>{t("section.cta_desc")}</p>
        <a href={href("/contact")} class="button button-primary">{t("section.cta_button")}<span>↗</span></a>
        <div class="cta-decoration" aria-hidden="true">{`{ build(); }`}</div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .section-shell { width: min(calc(100% - 2.5rem), var(--max-width)); margin-inline: auto; }
  .hero { width: min(calc(100% - 2.5rem), var(--max-width)); margin: 0 auto; padding: clamp(4rem, 9vw, 8rem) 0 4rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr); align-items: center; gap: clamp(2.5rem, 6vw, 6.5rem); }
  .eyebrow { display: flex; align-items: center; gap: .65rem; margin-bottom: 1.3rem; color: var(--text-secondary); font: 500 var(--fs-label) var(--mono); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .eyebrow span { color: var(--accent); }
  .hero h1 { max-width: 720px; margin: 0; color: var(--text); font-size: var(--fs-display); font-weight: 700; line-height: var(--leading-display); letter-spacing: var(--tracking-display); text-wrap: balance; }
  .hero h1 em { color: var(--accent); font-style: normal; }
  .hero h1 .nowrap { white-space: nowrap; }
  .hero-description { max-width: 650px; margin: 1.5rem 0 1.25rem; color: var(--text-secondary); font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.75; }
  .availability { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; color: var(--text-muted); font: 400 var(--fs-label) var(--mono); }
  .availability i { width: 1px; height: 13px; background: var(--border-strong); }
  .status-light { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 11px var(--accent-glow); animation: glow 2.2s ease-in-out infinite; }
  @keyframes glow { 50% { opacity: .45; } }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .code-window { overflow: hidden; border: 1px solid var(--border-strong); border-radius: 12px; background: var(--bg-elevated); box-shadow: 0 34px 90px rgba(0,0,0,.32); transform: rotate(1deg); }
  .window-bar, .window-footer { display: flex; align-items: center; height: 38px; border-bottom: 1px solid var(--border); background: var(--surface-2); color: var(--text-muted); font: 400 var(--fs-label) var(--mono); }
  .window-bar { justify-content: space-between; padding: 0 .8rem; }
  .window-dots { display: flex; gap: 5px; }
  .window-dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--border-strong); }
  .window-dots span:first-child { background: var(--syntax-red); }.window-dots span:nth-child(2) { background: var(--syntax-yellow); }.window-dots span:last-child { background: var(--syntax-green); }
  .branch::before { content: "⌘ "; }
  .code-body { padding: 1.3rem .85rem 1.4rem; color: var(--code-text); font: 400 clamp(.65rem, 1.05vw, .78rem)/1.9 var(--mono); white-space: nowrap; }
  .ln { display: inline-block; width: 2.1rem; color: var(--text-decor); user-select: none; }.purple { color: var(--syntax-purple); }.blue { color: var(--info); }.green { color: var(--accent); }
  .terminal-line { margin-top: .55rem; padding-top: .55rem; border-top: 1px solid var(--border); }.prompt { color: var(--accent); margin-right: .5rem; }.cursor { display: inline-block; width: 6px; height: 1em; margin-left: 4px; background: var(--accent); vertical-align: -2px; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .window-footer { justify-content: space-between; height: 28px; padding: 0 .8rem; border-top: 1px solid var(--border); border-bottom: 0; color: var(--text-subtle); }
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr) 1.45fr; margin-top: clamp(3.5rem, 7vw, 6rem); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .metrics > div { min-height: 96px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--border); }
  .metrics > div:last-child { border-right: 0; }
  .metrics strong { color: var(--text); font: 600 1.65rem var(--mono); }.metrics span { color: var(--text-muted); font: var(--fs-label) var(--mono); text-transform: uppercase; letter-spacing: var(--tracking-label); }
  .metrics .metric-note { flex-direction: row; align-items: center; gap: .8rem; }.metric-note .commit-icon { color: var(--accent); font-size: .8rem; }.metric-note p { margin: 0; color: var(--text-muted); font: var(--fs-label)/1.65 var(--mono); }.metric-note b { color: var(--text-secondary); font-weight: 500; }
  .work-section, .approach, .stack-section { padding-top: clamp(5rem, 10vw, 9rem); }
  .section-intro { display: grid; grid-template-columns: 1.15fr .85fr; align-items: end; gap: 3rem; margin-bottom: 2.5rem; }
  .section-intro.compact { display: block; }
  .kicker { display: block; margin-bottom: .8rem; color: var(--accent); font: 500 var(--fs-label) var(--mono); text-transform: uppercase; letter-spacing: var(--tracking-label); }
  .section-intro h2, .stack-heading h2 { max-width: 680px; margin: 0; color: var(--text); font-size: clamp(2rem, 4vw, 3.45rem); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
  .section-intro > p { max-width: 460px; margin: 0 0 .2rem; color: var(--text-muted); font-size: .94rem; line-height: 1.75; }
  .project-list { border-top: 1px solid var(--border-strong); }
  .project-row { display: grid; grid-template-columns: minmax(320px, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 5rem); padding: 2rem 0; border-bottom: 1px solid var(--border); }
  .project-visual { position: relative; display: block; aspect-ratio: 16/10; overflow: hidden; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .project-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, color-mix(in srgb, var(--bg) 30%, transparent), transparent 55%); }
  .project-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease, filter .5s ease; }
  .project-visual img.is-portrait { object-fit: contain; }
  .project-row:hover img { transform: scale(1.025); }
  .project-number { position: absolute; z-index: 1; left: .75rem; bottom: .7rem; display: grid; place-items: center; width: 30px; height: 26px; border: 1px solid var(--border-strong); border-radius: 5px; background: color-mix(in srgb, var(--bg) 75%, transparent); color: var(--accent); font: var(--fs-label) var(--mono); backdrop-filter: blur(8px); }
  .project-info { display: flex; flex-direction: column; justify-content: center; padding-right: clamp(0rem, 3vw, 3rem); }
  .project-meta { display: flex; justify-content: space-between; padding-bottom: .75rem; border-bottom: 1px solid var(--border); color: var(--text-subtle); font: var(--fs-label) var(--mono); text-transform: uppercase; }
  .project-info h3 { margin: 1rem 0 .7rem; font-size: clamp(1.65rem, 3vw, 2.55rem); letter-spacing: var(--tracking-heading); }.project-info h3 a { color: var(--text); text-decoration: none; }
  .project-info p { margin: 0; color: var(--text-muted); font-size: .9rem; line-height: 1.7; }
  .project-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.2rem; }.project-tags span { padding: .3rem .5rem; border: 1px solid var(--border); border-radius: 5px; background: var(--tint); color: var(--text-secondary); font: var(--fs-label) var(--mono); }
  .project-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.4rem; }.project-links a { display: inline-flex; align-items: center; gap: .45rem; color: var(--accent); font: 500 var(--fs-link) var(--mono); text-decoration: none; }.project-links a:last-child { color: var(--info); }.project-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .all-projects { display: inline-flex; align-items: center; gap: .65rem; margin-top: 1.4rem; color: var(--text-secondary); font: 500 var(--fs-link) var(--mono); text-decoration: none; }.all-projects span { color: var(--accent); }.all-projects:hover { color: var(--text); }
  .approach-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.4rem; border-top: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong); }
  .approach-grid article { padding: 1.75rem; border-right: 1px solid var(--border); }.approach-grid article:last-child { border-right: 0; }.approach-grid article > span { color: var(--accent); font: var(--fs-label) var(--mono); }.approach-grid h3 { margin: 2.5rem 0 .7rem; color: var(--text); font-size: 1.15rem; }.approach-grid p { margin: 0; color: var(--text-muted); font-size: .84rem; line-height: 1.7; }
  .stack-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .stack-heading { position: sticky; top: 110px; }
  .stack-list { border-top: 1px solid var(--border-strong); }
  .stack-row { padding: 1.25rem 0; border-bottom: 1px solid var(--border); }.stack-row h3 { margin: 0 0 .9rem; color: var(--text-subtle); font: 500 var(--fs-label) var(--mono); text-transform: uppercase; }.stack-row > div { display: flex; flex-wrap: wrap; gap: .55rem; }.stack-row span { padding: .42rem .65rem; border: 1px solid var(--border); border-radius: 6px; color: var(--text-secondary); font: var(--fs-label) var(--mono); transition: border-color .2s ease, color .2s ease; }.stack-row span:hover { border-color: var(--accent-border); color: var(--accent); }
  .cta { padding-top: clamp(5rem, 10vw, 9rem); padding-bottom: 3rem; }.cta-card { position: relative; overflow: hidden; padding: clamp(2.2rem, 6vw, 5rem); border: 1px solid var(--accent-border); border-radius: 14px; background: linear-gradient(120deg, color-mix(in srgb, var(--accent) 7%, var(--surface)), color-mix(in srgb, var(--info) 3.5%, var(--surface)) 48%, var(--surface)); }.cta-status { display: flex; align-items: center; gap: .5rem; color: var(--accent); font: var(--fs-label) var(--mono); text-transform: uppercase; }.cta-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }.cta h2 { max-width: 700px; margin: 1.2rem 0 .8rem; color: var(--text); font-size: clamp(2rem, 4.6vw, 3.9rem); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }.cta p { max-width: 590px; margin: 0 0 1.7rem; color: var(--text-muted); font-size: .94rem; line-height: 1.7; }.cta-decoration { position: absolute; right: -1rem; bottom: -2.5rem; color: color-mix(in srgb, var(--accent) 4.5%, transparent); font: 600 clamp(4rem, 11vw, 9rem) var(--mono); white-space: nowrap; pointer-events: none; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }.code-window { max-width: 620px; transform: none; }.metrics { grid-template-columns: repeat(3, 1fr); }.metrics .metric-note { grid-column: 1/-1; border-top: 1px solid var(--border); }.project-row { grid-template-columns: 1fr 1fr; gap: 2rem; }.stack-section { grid-template-columns: 1fr; }.stack-heading { position: static; }.section-intro { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 680px) {
    .hero { padding-top: 3.5rem; }.hero h1 { font-size: var(--fs-display-sm); }.hero-actions .button { width: 100%; }.code-window { display: none; }.metrics { grid-template-columns: 1fr 1fr; }.metrics > div:nth-child(2) { border-right: 0; }.metrics > div:nth-child(3) { border-top: 1px solid var(--border); }.metrics .metric-note { grid-column: auto; border-top: 1px solid var(--border); }.project-row { grid-template-columns: 1fr; gap: 1.3rem; }.project-info { padding: 0 0 .5rem; }.approach-grid { grid-template-columns: 1fr; }.approach-grid article { border-right: 0; border-bottom: 1px solid var(--border); }.approach-grid article:last-child { border-bottom: 0; }.approach-grid h3 { margin-top: 1.5rem; }.cta-decoration { display: none; }
  }
  @media (max-width: 420px) {
    .section-shell, .hero { width: min(calc(100% - 1.5rem), var(--max-width)); }.code-body { overflow-x: auto; }.metrics { grid-template-columns: 1fr; }.metrics > div { border-right: 0; border-bottom: 1px solid var(--border); }.metrics > div:nth-child(3), .metrics .metric-note { border-top: 0; }.metrics > div:last-child { border-bottom: 0; }
  }
</style>
