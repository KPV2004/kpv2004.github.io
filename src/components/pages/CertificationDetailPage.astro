---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'certificates'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const t = useTranslations(lang);
---

<Layout>
  <Navbar />

  <article class="detail-container" id="main-content">
    <div class="back-nav">
      <a href="/certifications" class="back-link">&larr; Back to Certificates</a>
    </div>

    <header class="detail-header">
      <div class="header-top">
        <span class="cert-issuer">Issued by {data.issuer}</span>
        <span class="cert-date">{data.date}</span>
      </div>

      <h1 class="detail-title">{data.title}</h1>

      <div class="skills-list">
        {data.skills.map((skill) => (
          <span class="skill-pill">{skill}</span>
        ))}
      </div>
    </header>

    <main class="mdx-content">
      <Content />
    </main>
  </article>

  <Footer />
</Layout>

<style>
  .detail-container {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.25rem 4rem;
  }

  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: #79c0ff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #9aefa1;
    text-decoration: underline;
  }

  .detail-header {
    background: rgba(17, 23, 31, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 2.5rem;
    backdrop-filter: blur(12px);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cert-issuer {
    font-size: 0.9rem;
    font-weight: 600;
    color: #d2a8ff;
  }

  .cert-date {
    font-size: 0.88rem;
    color: #8e9ba9;
  }

  .detail-title {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1.25rem 0;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skill-pill {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.05);
    color: #edf4f8;
    padding: 0.25rem 0.65rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* MDX Content Styling */
  .mdx-content {
    background: rgba(17, 23, 31, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    color: #b7c2cd;
    line-height: 1.75;
    font-size: 1rem;
    overflow-x: hidden;
  }

  .mdx-content :global(h1),
  .mdx-content :global(h2),
  .mdx-content :global(h3) {
    color: #ffffff;
    margin-top: 1.75rem;
    margin-bottom: 0.85rem;
    font-weight: 700;
  }

  .mdx-content :global(h1) { font-size: clamp(1.4rem, 4vw, 1.8rem); }
  .mdx-content :global(h2) { font-size: clamp(1.2rem, 3.5vw, 1.4rem); border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.4rem; }

  .mdx-content :global(p) {
    margin-bottom: 1.15rem;
  }

  .mdx-content :global(img) {
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin: 1.5rem 0;
  }
</style>
