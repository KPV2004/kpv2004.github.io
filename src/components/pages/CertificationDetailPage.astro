---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { useTranslations, localizePath, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'certificates'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${data.title} — ${t('meta.site_name')}`} description={`${data.title} · ${t('cert.issued_by')} ${data.issuer}`}>
  <Navbar lang={lang} />

  <article class="page-shell page-shell--reading detail-page" id="main-content">
    <a href={localizePath('/certifications', lang)} class="text-link">&larr; {t('detail.back_certifications')}</a>

    <header class="detail-header">
      <div class="detail-top">
        <span class="badge">{t('cert.issued_by')} {data.issuer}</span>
        <span class="meta">{data.date}</span>
      </div>

      <h1 class="detail-title">{data.title}</h1>

      <div class="tag-list">
        {data.skills.map((skill) => <span class="tag">{skill}</span>)}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <Footer lang={lang} />
</Layout>
