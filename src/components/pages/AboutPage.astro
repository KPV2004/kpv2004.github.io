---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { useTranslations, type Lang } from "../../utils/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const education = [
    {
        degree: t("about.edu_degree"),
        institution: t("about.university"),
        year: "2022 - 2025",
        logo: "/images/kusrc.png",
        notes: t("about.edu_notes"),
    },
];

const experience = [
    {
        role: "ERP Developer (AX & Full-Stack Developer)",
        company: "D Plus Intertrade Co., Ltd.",
        period: t("about.exp_dplus_period"),
        logo: "/images/dplus-logo.png",
        description: t("about.exp_dplus_desc"),
    },
    {
        role: t("about.exp_tsh_role"),
        company: "Thai Summit Harness Public Company Limited",
        period: t("about.exp_tsh_period"),
        logo: "/images/tsh.png",
        description: t("about.exp_tsh_desc"),
    },
];
---

<Layout lang={lang} title={t("meta.about_title")} description={t("meta.about_description")}>
    <Navbar lang={lang} />

    <main class="page-shell" id="main-content">
        <header class="page-header">
            <span class="section-tag">{t("about.tag")}</span>
            <h1 class="page-title">{t("about.title")}</h1>
            <p class="page-description">
                {t("about.intro")}
                <strong>{t("about.university")}</strong>
            </p>
        </header>

        <div class="about-container">
            <div class="bio-grid">
                <div class="bio-card">
                    <h2 class="card-heading">{t("about.bio_heading")}</h2>
                    <p>{t("about.bio_p1")}</p>
                    <p>{t("about.bio_p2")}</p>
                </div>

                <div class="bio-card">
                    <h2 class="card-heading">{t("about.facts")}</h2>
                    <ul class="facts-list">
                        <li><strong>{t("about.fact_name")}</strong> {t("about.title")}</li>
                        <li><strong>{t("about.fact_university")}</strong> {t("about.university")}</li>
                        <li><strong>{t("about.fact_degree")}</strong> {t("about.fact_degree_value")}</li>
                        <li><strong>{t("about.fact_languages")}</strong> C++, Python, Java, JavaScript, TypeScript</li>
                        <li><strong>{t("about.fact_role")}</strong> ERP Developer (AX) & Full-Stack Developer</li>
                        <li><strong>{t("about.fact_location")}</strong> {t("about.fact_location_value")}</li>
                        <li><strong>GPA:</strong> 3.49 / 4.00</li>
                        <li><strong>GitHub:</strong> github.com/KPV2004</li>
                    </ul>
                </div>
            </div>

            <!-- Work Experience Section -->
            <div class="timeline-section">
                <h2 class="section-heading">{t("about.experience")}</h2>
                <div class="timeline">
                    {
                        experience.map((exp) => (
                            <div class="timeline-item">
                                <div class="timeline-dot" />
                                <div class="timeline-content">
                                    <div class="content-wrapper">
                                        {exp.logo && (
                                            <div class="logo-box">
                                                <img src={exp.logo} alt={exp.company} width="48" height="48" loading="lazy" />
                                            </div>
                                        )}
                                        <div class="details-box">
                                            <div class="timeline-header">
                                                <h3 class="role-title">
                                                    {exp.role}
                                                </h3>
                                                <span class="badge">
                                                    {exp.period}
                                                </span>
                                            </div>
                                            <h4 class="company-name">
                                                {exp.company}
                                            </h4>
                                            <p class="exp-desc">
                                                {exp.description}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Education Section -->
            <div class="timeline-section">
                <h2 class="section-heading">{t("about.education")}</h2>
                <div class="timeline">
                    {
                        education.map((edu) => (
                            <div class="timeline-item">
                                <div class="timeline-dot" />
                                <div class="timeline-content">
                                    <div class="content-wrapper">
                                        {edu.logo && (
                                            <div class="logo-box">
                                                <img src={edu.logo} alt={edu.institution} width="48" height="48" loading="lazy" />
                                            </div>
                                        )}
                                        <div class="details-box">
                                            <div class="timeline-header">
                                                <h3 class="role-title">
                                                    {edu.degree}
                                                </h3>
                                                <span class="badge">
                                                    {edu.year}
                                                </span>
                                            </div>
                                            <h4 class="company-name">
                                                {edu.institution}
                                            </h4>
                                            <p class="exp-desc">{edu.notes}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </main>

    <Footer lang={lang} />
</Layout>

<style>
    .about-container { display: flex; flex-direction: column; gap: clamp(3rem, 6vw, 4rem); }

    .bio-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 1.5rem; }
    .bio-card {
        padding: clamp(1.5rem, 4vw, 2rem);
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        background: var(--surface);
    }
    .card-heading { margin: 0 0 1.25rem; color: var(--text); font-size: var(--fs-card-title); font-weight: 700; letter-spacing: var(--tracking-title); }
    .bio-card p { margin: 0 0 1rem; color: var(--text-secondary); line-height: 1.7; }
    .bio-card p:last-child { margin: 0; }

    .facts-list { display: flex; flex-direction: column; gap: .9rem; margin: 0; padding: 0; list-style: none; }
    .facts-list li { padding-bottom: .75rem; border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: .9375rem; }
    .facts-list li:last-child { padding-bottom: 0; border-bottom: 0; }
    .facts-list strong { margin-right: .5rem; color: var(--text); }

    .section-heading { margin: 0 0 2rem; color: var(--text); font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 700; letter-spacing: var(--tracking-heading); }

    .timeline { position: relative; display: flex; flex-direction: column; gap: 1.5rem; padding-left: 2rem; border-left: 2px solid var(--accent-border); }
    .timeline-item { position: relative; }
    .timeline-dot {
        position: absolute;
        top: 1.6rem;
        left: calc(-2rem - 8px);
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 10px var(--accent-glow);
    }
    .timeline-content { padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--surface); }
    .content-wrapper { display: flex; align-items: flex-start; gap: 1.25rem; }
    /* Company logos are drawn for light backgrounds. */
    .logo-box { display: grid; place-items: center; flex-shrink: 0; width: 60px; height: 60px; padding: 6px; border-radius: 12px; background: #ffffff; }
    .logo-box img { width: 100%; height: 100%; object-fit: contain; }
    .details-box { flex-grow: 1; }
    .timeline-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .4rem; }
    .role-title { margin: 0; color: var(--text); font-size: 1.2rem; font-weight: 700; }
    .company-name { margin: 0 0 .75rem; color: var(--syntax-purple); font-size: .9375rem; font-weight: 600; }
    .exp-desc { margin: 0; color: var(--text-muted); font-size: .9375rem; line-height: 1.6; }

    @media (max-width: 768px) {
        .bio-grid { grid-template-columns: 1fr; }
        .content-wrapper { flex-direction: column; }
    }
</style>
