---
import { getLangFromUrl } from "../utils/i18n";

interface Props {
    title?: string;
    description?: string;
}

const lang = getLangFromUrl(Astro.url);
const {
    title = "Pannet Vanicharkorl — Software Engineer",
    description = "Software engineer and Computer Engineering graduate building reliable, thoughtful digital products.",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#080b0f" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <div class="site-noise" aria-hidden="true"></div>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        color-scheme: dark;
        --bg: #080b0f;
        --bg-elevated: #0d1218;
        --surface: #11171f;
        --surface-2: #151d27;
        --line: rgba(157, 176, 198, 0.14);
        --line-strong: rgba(157, 176, 198, 0.24);
        --text: #edf4f8;
        --muted: #8e9ba9;
        --muted-strong: #b7c2cd;
        --green: #7ee787;
        --green-soft: rgba(126, 231, 135, 0.1);
        --blue: #79c0ff;
        --blue-soft: rgba(121, 192, 255, 0.1);
        --purple: #d2a8ff;
        --max-width: 1180px;
        --sans: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
        scroll-behavior: smooth;
        background: var(--bg);
    }

    body {
        margin: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        background:
            radial-gradient(circle at 14% 0%, rgba(121, 192, 255, 0.07), transparent 30rem),
            radial-gradient(circle at 90% 18%, rgba(126, 231, 135, 0.05), transparent 28rem),
            var(--bg);
        color: var(--text);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image:
            linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: linear-gradient(to bottom, black, transparent 80%);
    }

    .site-noise {
        position: fixed;
        inset: 0;
        z-index: 9999;
        opacity: .018;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
    }

    ::selection { background: rgba(126, 231, 135, .3); color: #fff; }

    a, button, input, textarea { -webkit-tap-highlight-color: transparent; }
    a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
        outline: 2px solid var(--green);
        outline-offset: 3px;
    }

    .skip-link {
        position: fixed;
        top: .75rem;
        left: .75rem;
        z-index: 10000;
        transform: translateY(-180%);
        padding: .65rem 1rem;
        border-radius: 8px;
        background: var(--green);
        color: #071009;
        font: 600 .82rem var(--mono);
        text-decoration: none;
        transition: transform .2s ease;
    }
    .skip-link:focus { transform: translateY(0); }

    nav ul, nav ol, .nav-links, .mobile-links { list-style: none !important; margin: 0; padding: 0; }
    img, video, iframe, svg { max-width: 100%; height: auto; }

    /* Shared visual language for inner and MDX pages. */
    .page-header {
        padding-top: clamp(4.5rem, 9vw, 7rem) !important;
        background: radial-gradient(circle at 50% 0%, rgba(121, 192, 255, .09), transparent 62%) !important;
    }
    .section-tag, .back-link, .details-link, .card-link, .view-all-link { color: var(--green) !important; }
    .section-tag, .category-badge, .tag-pill, .tag-chip, .skill-tag, .tech-pill, .skill-pill, .period-badge, .award-badge, .cert-issuer, .cert-date, .comp-date {
        font-family: var(--mono) !important;
    }
    .page-title, .detail-title, .section-title, .card-heading, .section-heading { color: var(--text) !important; letter-spacing: -.04em; }
    .page-description, .detail-desc, .project-desc, .card-description, .exp-desc, .info-intro { color: var(--muted) !important; }
    .project-card, .comp-card, .cert-card, .bio-card, .timeline-content, .info-card, .form-card, .detail-header, .mdx-content {
        background: rgba(17, 23, 31, .86) !important;
        border-color: var(--line) !important;
        border-radius: 14px !important;
        box-shadow: none !important;
    }
    .project-card:hover, .comp-card:hover, .cert-card:hover {
        border-color: rgba(126, 231, 135, .42) !important;
        box-shadow: 0 24px 65px rgba(0, 0, 0, .28) !important;
    }
    .details-btn, .submit-btn, .btn-demo {
        background: var(--green) !important;
        color: #08110a !important;
        box-shadow: none !important;
    }
    .category-badge, .period-badge {
        color: var(--blue) !important;
        background: var(--blue-soft) !important;
        border-color: rgba(121, 192, 255, .2) !important;
    }
    .tag-pill, .tag-chip, .skill-tag, .tech-pill, .skill-pill {
        color: var(--muted-strong) !important;
        background: rgba(255,255,255,.035) !important;
        border-color: var(--line) !important;
    }
    .form-group input, .form-group textarea {
        background: #0b1016 !important;
        border-color: var(--line) !important;
        color: var(--text) !important;
    }
    .form-group input:focus, .form-group textarea:focus { border-color: var(--green) !important; box-shadow: 0 0 0 3px rgba(126,231,135,.1) !important; }
    .mdx-content :where(h1, h2, h3) { color: var(--text) !important; }
    .mdx-content :where(p, li) { color: var(--muted-strong) !important; }
    .mdx-content a { color: var(--blue) !important; }

    /* Footer lives here so its theme is always loaded with the shared layout. */
    footer.portfolio-footer {
        position: relative;
        margin-top: clamp(3.5rem, 7vw, 6rem);
        border-top: 1px solid var(--line);
        background:
            radial-gradient(circle at 12% 0%, rgba(126, 231, 135, .065), transparent 25rem),
            linear-gradient(180deg, #090d12 0%, #070a0e 100%);
        color: var(--text);
        font-family: var(--sans);
    }
    .portfolio-footer .footer-shell {
        width: min(calc(100% - 2.5rem), var(--max-width));
        margin: 0 auto;
    }
    .portfolio-footer .footer-main {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(110px, .7fr) minmax(110px, .7fr);
        gap: clamp(2rem, 7vw, 7rem);
        padding: 3.5rem 0;
    }
    .portfolio-footer .brand-line {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        color: var(--text);
        font-size: .9rem;
        font-weight: 700;
        text-decoration: none;
    }
    .portfolio-footer .brand-line > span {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border: 1px solid rgba(126, 231, 135, .36);
        border-radius: 7px;
        background: var(--green-soft);
        color: var(--green);
        font: 600 .66rem var(--mono);
    }
    .portfolio-footer .footer-brand p {
        max-width: 470px;
        margin: 1rem 0 1.2rem;
        color: var(--muted);
        font-size: .84rem;
        line-height: 1.7;
    }
    .portfolio-footer .email {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--green);
        font: .68rem var(--mono);
        text-decoration: none;
        overflow-wrap: anywhere;
    }
    .portfolio-footer .email:hover { text-decoration: underline; text-underline-offset: 4px; }
    .portfolio-footer .footer-nav,
    .portfolio-footer .footer-social {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: .72rem;
    }
    .portfolio-footer .footer-label {
        display: block;
        margin-bottom: .35rem;
        color: #596877;
        font: 500 .6rem var(--mono);
        text-transform: uppercase;
        letter-spacing: .08em;
    }
    .portfolio-footer .footer-nav a,
    .portfolio-footer .footer-social a {
        display: inline-flex;
        gap: .35rem;
        color: var(--muted-strong);
        font-size: .78rem;
        text-decoration: none;
        transition: color .2s ease, transform .2s ease;
    }
    .portfolio-footer .footer-nav a:hover,
    .portfolio-footer .footer-social a:hover {
        color: var(--green);
        transform: translateX(3px);
    }
    .portfolio-footer .footer-social a span { color: #596877; }
    .portfolio-footer .footer-bottom {
        min-height: 68px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        border-top: 1px solid var(--line);
        color: #64717e;
        font: .6rem var(--mono);
    }
    .portfolio-footer .footer-bottom p { margin: 0; }
    .portfolio-footer .footer-bottom p:nth-child(2) { display: flex; align-items: center; gap: .45rem; }
    .portfolio-footer .footer-bottom p:last-child { text-align: right; }
    .portfolio-footer .status-dot {
        display: inline-block;
        flex: 0 0 auto;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 9px rgba(126, 231, 135, .6);
    }
    .portfolio-footer .version { color: var(--green); }

    ::-webkit-scrollbar { width: 9px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: #25313e; border: 2px solid var(--bg); border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #344456; }

    @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }

    @media (max-width: 700px) {
        .portfolio-footer .footer-main { grid-template-columns: 1fr 1fr; }
        .portfolio-footer .footer-brand { grid-column: 1 / -1; }
        .portfolio-footer .footer-bottom { grid-template-columns: 1fr; padding: 1.2rem 0; text-align: left; }
        .portfolio-footer .footer-bottom p:last-child { text-align: left; }
    }
    @media (max-width: 420px) {
        .portfolio-footer .footer-shell { width: min(calc(100% - 1.5rem), var(--max-width)); }
    }
</style>
