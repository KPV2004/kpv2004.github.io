---
import { getLangFromUrl, useTranslations, type Lang } from "../utils/i18n";
import "../styles/components.css";

interface Props {
    lang?: Lang;
    title?: string;
    description?: string;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
    title = t("meta.default_title"),
    description = t("meta.default_description"),
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#080b0f" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">{t("layout.skip_link")}</a>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        color-scheme: dark;

        /* Surfaces */
        --bg: #0c0d0e;
        --bg-elevated: #0f1112;
        --surface: #121416;
        --surface-2: #17191c;
        --surface-sunken: #0e1012;
        --tint: rgba(230, 232, 234, .03);
        --tint-hover: rgba(230, 232, 234, .05);
        --header-bg: rgba(12, 13, 14, .85);

        /* Borders */
        --border: #1d2023;
        --border-strong: #2a2e33;
        --border-input: #5c636b;   /* 3.1:1 on --surface-sunken */

        /* Text (contrast measured on --bg) */
        --text: #e6e8ea;           /* 15.9:1 */
        --text-secondary: #b4b9be; /* 10.3:1 */
        --text-muted: #9aa0a6;     /*  7.5:1 */
        --text-subtle: #8a9096;    /*  6.0:1 labels, meta, footer */
        --text-decor: #40454b;     /* decorative only, e.g. code line numbers */

        /* Accent: one quiet green, used sparingly (links, kickers, focus) */
        --accent: #7fb88a;         /*  8.6:1 */
        --accent-hover: #95c79f;
        --accent-strong: #6aa575;
        --on-accent: #0c0d0e;
        --accent-soft: rgba(127, 184, 138, .07);
        --accent-border: rgba(127, 184, 138, .28);
        --accent-glow: transparent;

        /* Secondary roles collapse to neutrals; the accent is the only hue */
        --info: var(--text-secondary);
        --info-soft: var(--tint);
        --info-border: var(--border-strong);
        --award: var(--accent);
        --award-soft: var(--accent-soft);
        --award-border: var(--accent-border);
        --syntax-purple: var(--text-secondary);
        --syntax-red: var(--border-strong);
        --syntax-yellow: var(--border-strong);
        --syntax-green: var(--border-strong);
        --code-text: #c9cdd1;

        /* Primary button is neutral (light on dark) */
        --button-primary-bg: var(--text);
        --button-primary-hover: #ffffff;
        --on-button-primary: var(--bg);

        /* States */
        --focus-ring: var(--accent);
        --selection: rgba(127, 184, 138, .25);
        --scrollbar: #24282c;
        --scrollbar-hover: #33383d;
        --shadow-raised: none;

        /* Shape and layout */
        --radius-card: 14px;
        --radius-control: 8px;
        --radius-pill: 999px;
        --max-width: 1180px;
        --reading-width: 860px;

        /* Type */
        /* Manrope and Plex Mono have no Thai glyphs; Thai falls through to Plex Sans Thai. */
        --sans: "Manrope", "IBM Plex Sans Thai", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --mono: "IBM Plex Mono", "IBM Plex Sans Thai", "SFMono-Regular", Consolas, monospace;
        --fs-label: .75rem;
        --fs-link: .8125rem;
        --fs-card-title: 1.375rem;
        --fs-page-title: clamp(2.25rem, 4vw, 3.45rem);
        --fs-display: clamp(2.8rem, 5.4vw, 5.25rem);
        --fs-display-sm: clamp(2.4rem, 13vw, 3.6rem);
        --leading-display: 1.04;
        --leading-heading: 1.08;
        --tracking-display: -.065em;
        --tracking-heading: -.05em;
        --tracking-title: -.03em;
        --tracking-label: .08em;

        /* Temporary aliases for the old token names; prefer the names above. */
        --line: var(--border);
        --line-strong: var(--border-strong);
        --muted: var(--text-muted);
        --muted-strong: var(--text-secondary);
        --green: var(--accent);
        --green-soft: var(--accent-soft);
        --blue: var(--info);
        --blue-soft: var(--info-soft);
        --purple: var(--syntax-purple);
    }

    /* Thai: negative tracking makes stacked vowels and tone marks collide, and
       they need taller lines. Small mono labels get a size bump instead. */
    html:lang(th) {
        --fs-display: clamp(2.5rem, 4.8vw, 4.5rem);
        --fs-display-sm: clamp(2.2rem, 10.5vw, 3rem);
        --fs-page-title: clamp(1.75rem, 3.6vw, 3rem);
        --fs-label: .8125rem;
        --leading-display: 1.3;
        --leading-heading: 1.3;
        --tracking-display: 0;
        --tracking-heading: 0;
        --tracking-title: 0;
        --tracking-label: 0;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
        scroll-behavior: smooth;
        background: var(--bg);
    }

    body {
        margin: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }


    ::selection { background: var(--selection); color: var(--text); }

    button, input, textarea, select { font: inherit; color: inherit; }

    a, button, input, textarea { -webkit-tap-highlight-color: transparent; }
    a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
        outline: 2px solid var(--focus-ring);
        outline-offset: 3px;
    }

    .skip-link {
        position: fixed;
        top: .75rem;
        left: .75rem;
        z-index: 10000;
        transform: translateY(-180%);
        padding: .65rem 1rem;
        border-radius: var(--radius-control);
        background: var(--accent);
        color: var(--on-accent);
        font: 600 .82rem var(--mono);
        text-decoration: none;
        transition: transform .2s ease;
    }
    .skip-link:focus { transform: translateY(0); }

    nav ul, nav ol { list-style: none; margin: 0; padding: 0; }
    img, video, iframe, svg { max-width: 100%; height: auto; }

    /* Footer lives here so its theme is always loaded with the shared layout. */
    footer.portfolio-footer {
        position: relative;
        margin-top: clamp(3.5rem, 7vw, 6rem);
        border-top: 1px solid var(--border);
        background: var(--bg-elevated);
        color: var(--text);
        font-family: var(--sans);
    }
    .portfolio-footer .footer-shell {
        width: min(calc(100% - 2.5rem), var(--max-width));
        margin: 0 auto;
    }
    .portfolio-footer .footer-main {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(110px, .7fr) minmax(110px, .7fr);
        gap: clamp(2rem, 7vw, 7rem);
        padding: 3.5rem 0;
    }
    .portfolio-footer .brand-line {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        color: var(--text);
        font-size: .9rem;
        font-weight: 700;
        text-decoration: none;
    }
    .portfolio-footer .brand-line > span {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--accent-border);
        border-radius: 7px;
        background: var(--accent-soft);
        color: var(--accent);
        font: 600 .66rem var(--mono);
    }
    .portfolio-footer .footer-brand p {
        max-width: 470px;
        margin: 1rem 0 1.2rem;
        color: var(--text-muted);
        font-size: .875rem;
        line-height: 1.7;
    }
    .portfolio-footer .email {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--accent);
        font: var(--fs-label) var(--mono);
        text-decoration: none;
        overflow-wrap: anywhere;
    }
    .portfolio-footer .email:hover { text-decoration: underline; text-underline-offset: 4px; }
    .portfolio-footer .footer-nav,
    .portfolio-footer .footer-social {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: .72rem;
    }
    .portfolio-footer .footer-label {
        display: block;
        margin-bottom: .35rem;
        color: var(--text-subtle);
        font: 500 var(--fs-label) var(--mono);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
    }
    .portfolio-footer .footer-nav a,
    .portfolio-footer .footer-social a {
        display: inline-flex;
        gap: .35rem;
        color: var(--text-secondary);
        font-size: .875rem;
        text-decoration: none;
        transition: color .2s ease, transform .2s ease;
    }
    .portfolio-footer .footer-nav a:hover,
    .portfolio-footer .footer-social a:hover {
        color: var(--accent);
        transform: translateX(3px);
    }
    .portfolio-footer .footer-social a span { color: var(--text-subtle); }
    .portfolio-footer .footer-bottom {
        min-height: 68px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        border-top: 1px solid var(--border);
        color: var(--text-subtle);
        font: var(--fs-label) var(--mono);
    }
    .portfolio-footer .footer-bottom p { margin: 0; }
    .portfolio-footer .footer-bottom p:nth-child(2) { display: flex; align-items: center; gap: .45rem; }
    .portfolio-footer .footer-bottom p:last-child { text-align: right; }
    .portfolio-footer .status-dot {
        display: inline-block;
        flex: 0 0 auto;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 9px var(--accent-glow);
    }
    .portfolio-footer .version { color: var(--accent); }

    ::-webkit-scrollbar { width: 9px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--scrollbar); border: 2px solid var(--bg); border-radius: var(--radius-pill); }
    ::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-hover); }

    @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }

    @media (max-width: 700px) {
        .portfolio-footer .footer-main { grid-template-columns: 1fr 1fr; }
        .portfolio-footer .footer-brand { grid-column: 1 / -1; }
        .portfolio-footer .footer-bottom { grid-template-columns: 1fr; padding: 1.2rem 0; text-align: left; }
        .portfolio-footer .footer-bottom p:last-child { text-align: left; }
    }
    @media (max-width: 420px) {
        .portfolio-footer .footer-shell { width: min(calc(100% - 1.5rem), var(--max-width)); }
    }
</style>
